---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { READING_PROGRESS_DOCK, type ReadingProgressDock } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	readingMinutes?: number;
	readingProgressDock?: ReadingProgressDock;
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	readingMinutes,
	readingProgressDock = READING_PROGRESS_DOCK,
	headings = [],
	tags = [],
} = Astro.props;

// Metadata carried into the Pagefind index alongside the post body.
// Matches the name on this post's PostCard so the card art morphs into the hero
const heroTransition = `post-${Astro.params.slug?.replace(/[^\w-]/g, '-')}`;

const searchDate = pubDate.toLocaleDateString('en-us', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
// Empty elements carry the values: a comma-joined attribute would be read as a
// single filter, and empty ones contribute no text to the indexed excerpt.
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		{readingMinutes && <ReadingProgress minutes={readingMinutes} dock={readingProgressDock} />}
		<main>
			<article data-pagefind-body data-pagefind-meta={`date:${searchDate}`}>
				{heroImage && <span data-pagefind-meta="image[data-value]" data-value={heroImage.src} />}
				{tags.map((tag) => <span data-pagefind-filter="tag[data-value]" data-value={tag} />)}

				<header class="post-head enter">
					<p class="meta" data-pagefind-ignore>
						<FormattedDate date={pubDate} />
						{
							readingMinutes && (
								<>
									<span class="dot" aria-hidden="true" />
									<span>{readingMinutes} min read</span>
								</>
							)
						}
						{
							updatedDate && (
								<>
									<span class="dot" aria-hidden="true" />
									<span class="last-updated-on">
										Updated <FormattedDate date={updatedDate} />
									</span>
								</>
							)
						}
					</p>
					<h1>{title}</h1>
					<p class="post-lede" data-pagefind-ignore>{description}</p>
					{
						tags.length > 0 && (
							<ul class="post-tags" role="list" data-pagefind-ignore>
								{tags.map((tag) => (
									<li>
										<a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
									</li>
								))}
							</ul>
						)
					}
				</header>

				{
					heroImage && (
						<div class="hero-image" data-pagefind-ignore>
							<span class="hero-glow" aria-hidden="true" />
							<Image
								width={1200}
								height={630}
								src={heroImage}
								alt=""
								style={`view-transition-name: ${heroTransition}`}
							/>
						</div>
					)
				}

				<div class="prose">
					<div data-pagefind-ignore>
						<TableOfContents headings={headings} />
					</div>
					<slot />
				</div>
			</article>
			<div class="prose comments" data-pagefind-ignore>
				<slot name="comments" />
			</div>
		</main>
		<Footer />

		<style>
			main {
				width: min(1200px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0;
			}

			.post-head {
				max-width: 860px;
				margin: 0 auto;
				padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2rem, 4vw, 3rem);
				text-align: center;
			}
			.meta {
				display: inline-flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: 0.6rem;
				margin: 0 0 1.5rem;
				padding: 0.45rem 0.95rem;
				font-family: var(--font-mono);
				font-size: 0.74rem;
				color: rgb(var(--gray));
				background: var(--glass);
				-webkit-backdrop-filter: blur(10px);
				backdrop-filter: blur(10px);
				border: 1px solid var(--border);
				border-radius: 999px;
			}
			.dot {
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: currentColor;
				opacity: 0.6;
			}
			.post-head h1 {
				margin: 0 0 1.25rem;
				font-family: var(--font-display);
				font-weight: 400;
				font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.6rem);
				line-height: 1.02;
				letter-spacing: -0.02em;
			}
			.post-lede {
				max-width: 60ch;
				margin: 0 auto;
				font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.2rem);
				line-height: 1.6;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem;
				margin: 1.75rem 0 0;
				padding: 0;
			}
			.post-tags li {
				list-style: none;
			}
			.post-tags a {
				display: inline-block;
				padding: 0.3rem 0.75rem;
				font-size: 0.78rem;
				font-weight: 520;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				background: var(--glass);
				border: 1px solid var(--border-strong);
				border-radius: 999px;
				transition:
					color 0.2s ease,
					border-color 0.2s ease,
					transform 0.3s var(--ease-spring);
			}
			.post-tags a::before {
				content: '#';
				margin-right: 0.1em;
				color: var(--accent);
			}
			.post-tags a:hover {
				color: var(--accent);
				border-color: var(--accent);
				transform: translateY(-2px);
			}

			.hero-image {
				position: relative;
				max-width: 1080px;
				margin: 0 auto clamp(2.5rem, 5vw, 4rem);
				animation: enter 1.1s var(--ease-out) 0.25s both;
			}
			/* the art casts a soft coloured light onto the page behind it */
			.hero-glow {
				position: absolute;
				inset: 8% 6% -4%;
				z-index: -1;
				border-radius: 40px;
				background: var(--grad);
				filter: blur(60px);
				opacity: 0.35;
			}
			.hero-image :global(img) {
				display: block;
				width: 100%;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				box-shadow: var(--box-shadow);
				view-transition-class: post-hero;
			}

			.prose {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
			}
			.comments {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
			}
			.comments :global(hr) {
				display: none;
			}
		</style>
	</body>
</html>

---
interface Props {
	tags: Map<string, number>;
}

const { tags } = Astro.props;

const sorted = [...tags.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const counts = [...tags.values()];
const minCount = Math.min(...counts);
const maxCount = Math.max(...counts);

function fontSize(count: number): string {
	if (maxCount === minCount) return '0.8rem';
	const scale = (count - minCount) / (maxCount - minCount);
	const size = 0.75 + scale * 0.5;
	return `${size}rem`;
}
---

<div class="tag-cloud">
	{sorted.map(([tag, count]) => (
		<a
			href={`/tags/${encodeURIComponent(tag)}/`}
			class="tag-pill"
			style={`font-size: ${fontSize(count)}`}
		>
			{tag} <span class="tag-count">{count}</span>
		</a>
	))}
</div>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin-top: 0.5rem;
	}
	.tag-pill {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35em;
		padding: 0.4em 0.9em;
		border-radius: 999px;
		background: var(--glass);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		border: 1px solid var(--border);
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 520;
		line-height: 1.3;
		white-space: nowrap;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease,
			transform 0.4s var(--ease-spring);
	}
	.tag-pill:hover {
		background: var(--ink-btn);
		border-color: var(--ink-btn);
		color: var(--on-ink-btn);
		transform: translateY(-3px) rotate(-1.5deg);
	}
	.tag-count {
		font-family: var(--font-mono);
		font-weight: 400;
		opacity: 0.55;
		font-size: 0.78em;
	}
</style>

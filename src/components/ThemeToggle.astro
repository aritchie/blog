---
/**
 * Light/dark switch. The stored value is only ever 'light' or 'dark' - clearing
 * it (or never setting it) means "follow the OS", which the CSS handles via
 * `prefers-color-scheme`. The attribute is applied before paint by the inline
 * script in BaseHead.astro; this component only handles clicks afterwards.
 *
 * Where view transitions are supported the new theme spreads out in a circle
 * from the button (styles in global.css, under "Theme switch").
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
	<span class="sr-only" data-theme-label>Switch to dark theme</span>
	<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<mask id="theme-toggle-moon">
			<rect x="0" y="0" width="24" height="24" fill="#fff"></rect>
			<circle class="moon-bite" cx="24" cy="4" r="7" fill="#000"></circle>
		</mask>
		<circle class="sun-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-toggle-moon)"
		></circle>
		<g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M12 1.8v2.4M12 19.8v2.4M22.2 12h-2.4M4.2 12H1.8M19.2 4.8l-1.7 1.7M6.5 17.5l-1.7 1.7M19.2 19.2l-1.7-1.7M6.5 6.5 4.8 4.8"
			></path>
		</g>
	</svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const label = document.querySelector<HTMLElement>('[data-theme-label]');
	const root = document.documentElement;

	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
	const resolved = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

	function sync() {
		const isDark = resolved() === 'dark';
		button?.setAttribute('aria-pressed', String(isDark));
		if (label) label.textContent = `Switch to ${isDark ? 'light' : 'dark'} theme`;
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', isDark ? '#0a0910' : '#f8f7f4');
		// third-party embeds (Disqus) sample the page colours once, on load
		window.dispatchEvent(new CustomEvent('themechange', { detail: isDark ? 'dark' : 'light' }));
	}

	function apply(next: string) {
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {
			// private browsing - the choice just won't survive the session
		}
		sync();
	}

	button?.addEventListener('click', (event) => {
		const next = resolved() === 'dark' ? 'light' : 'dark';
		const canAnimate = 'startViewTransition' in document && !reduced.matches;
		if (!canAnimate) {
			apply(next);
			return;
		}

		// the circle grows from the button to the farthest corner of the viewport
		const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
		root.style.setProperty('--vt-x', `${x}px`);
		root.style.setProperty('--vt-y', `${y}px`);
		root.style.setProperty('--vt-r', `${r}px`);
		root.classList.add('theme-vt');

		const transition = document.startViewTransition(() => apply(next));
		transition.finished.finally(() => root.classList.remove('theme-vt'));
	});

	// Someone on "follow the OS" should still flip when the OS flips
	systemDark.addEventListener('change', sync);
	sync();
</script>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		padding: 0;
		color: rgb(var(--black));
		background: transparent;
		border: 1px solid transparent;
		border-radius: 999px;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.4s var(--ease-spring);
	}
	.theme-toggle:hover {
		background: rgba(var(--gray-light), 70%);
	}
	.theme-toggle:active {
		transform: scale(0.9);
	}

	/* One glyph that morphs: the sun's core takes a bite and becomes the moon */
	.icon {
		width: 19px;
		height: 19px;
		overflow: visible;
		transition: transform 0.6s var(--ease-spring);
	}
	.sun-core {
		transition: r 0.5s var(--ease-out);
	}
	.moon-bite {
		transition:
			cx 0.5s var(--ease-out),
			cy 0.5s var(--ease-out);
	}
	.sun-rays {
		transform-origin: center;
		transition:
			opacity 0.35s ease,
			transform 0.5s var(--ease-spring);
	}

	/* light theme: show the moon (the destination) */
	.theme-toggle .icon {
		transform: rotate(-40deg);
	}
	.theme-toggle .sun-core {
		r: 8.5px;
	}
	.theme-toggle .moon-bite {
		cx: 16.5px;
		cy: 6.5px;
	}
	.theme-toggle .sun-rays {
		opacity: 0;
		transform: scale(0.5) rotate(-45deg);
	}

	/* dark theme: show the sun */
	.theme-toggle[aria-pressed='true'] .icon {
		transform: rotate(90deg);
	}
	.theme-toggle[aria-pressed='true'] .sun-core {
		r: 5px;
	}
	.theme-toggle[aria-pressed='true'] .moon-bite {
		cx: 26px;
		cy: 2px;
	}
	.theme-toggle[aria-pressed='true'] .sun-rays {
		opacity: 1;
		transform: none;
	}
</style>

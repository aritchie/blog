---
/*
  A breathing halftone field behind every page: a grid of dots whose size
  follows soft, slowly drifting waves of noise, so swells of colour roll
  across the page like light through a perforated screen. Dots near the
  pointer bloom outward.

  Colours and strength come from --motion-a / --motion-b / --motion-alpha in
  global.css, so it follows the theme toggle. Time is wall-clock based, which
  keeps the field continuous across page navigations. No WebGL2 means no
  canvas - the page just looks as it did before.
*/
---

<script>
	const VERT = `#version 300 es
in vec2 aPos;
void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;

	const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes;
uniform float uDpr;
uniform float uTime;
uniform vec2 uMouse;
uniform float uMouseAmt;
uniform vec3 uA;
uniform vec3 uB;
uniform float uAlpha;
out vec4 outColor;

vec2 hash(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(dot(hash(i), f), dot(hash(i + vec2(1, 0)), f - vec2(1, 0)), u.x),
		mix(dot(hash(i + vec2(0, 1)), f - vec2(0, 1)), dot(hash(i + vec2(1, 1)), f - vec2(1, 1)), u.x),
		u.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
	for (int i = 0; i < 4; i++) {
		s += a * noise(p);
		p = m * p;
		a *= 0.5;
	}
	return s;
}

void main() {
	// everything is measured in CSS pixels so every screen gets the same grid
	vec2 px = gl_FragCoord.xy / uDpr;
	float cell = 18.0;
	vec2 id = floor(px / cell);
	vec2 local = px - (id + 0.5) * cell;

	// sample the field once per dot, at its centre, so each dot stays round
	vec2 c = (id + 0.5) * cell / 520.0;
	float t = uTime * 0.04;
	vec2 q = vec2(fbm(c + vec2(0.0, t)), fbm(c + vec2(5.2, 1.3) - t * 0.8));
	float h = fbm(c * 1.3 + 1.4 * q + vec2(t * 0.5, -t * 0.3));
	float swell = smoothstep(-0.12, 0.3, h);
	swell *= swell;

	// a slow travelling ripple through the swells keeps it feeling alive
	float wave = 0.5 + 0.5 * sin(dot(c, vec2(2.2, 1.4)) * 2.4 - uTime * 0.35);
	swell *= mix(0.55, 1.0, wave);

	vec2 m = uMouse / uDpr;
	float md = length((id + 0.5) * cell - m);
	float bloom = uMouseAmt * exp(-md * md / 9000.0);
	swell = clamp(swell + bloom * 0.9, 0.0, 1.0);

	float r = mix(0.9, cell * 0.42, swell);
	float d = length(local);
	float disc = 1.0 - smoothstep(r - 0.75, r + 0.75, d);

	vec3 col = mix(uA, uB, clamp(swell * 0.7 + (px.x / max(uRes.x / uDpr, 1.0)) * 0.5 - 0.1, 0.0, 1.0));
	float a = disc * mix(0.3, 1.0, swell) * uAlpha;
	outColor = vec4(col * a, a);
}`;

	function parseColor(value: string): [number, number, number] {
		const hex = value.trim().replace('#', '');
		const full = hex.length === 3 ? [...hex].map((c) => c + c).join('') : hex;
		const n = parseInt(full, 16);
		return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
	}

	function compile(gl: WebGL2RenderingContext, type: number, src: string) {
		const shader = gl.createShader(type)!;
		gl.shaderSource(shader, src);
		gl.compileShader(shader);
		if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
			console.warn('[motion-bg]', gl.getShaderInfoLog(shader));
			return null;
		}
		return shader;
	}

	function start() {
		const canvas = document.createElement('canvas');
		canvas.className = 'motion-bg';
		canvas.setAttribute('aria-hidden', 'true');
		const gl = canvas.getContext('webgl2', {
			antialias: false,
			depth: false,
			premultipliedAlpha: true,
			alpha: true,
		});
		if (!gl) return;

		const vs = compile(gl, gl.VERTEX_SHADER, VERT);
		const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
		if (!vs || !fs) return;
		const program = gl.createProgram()!;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const aPos = gl.getAttribLocation(program, 'aPos');
		gl.enableVertexAttribArray(aPos);
		gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

		const u = (name: string) => gl.getUniformLocation(program, name);
		const uRes = u('uRes');
		const uDpr = u('uDpr');
		const uTime = u('uTime');
		const uMouse = u('uMouse');
		const uMouseAmt = u('uMouseAmt');
		const uA = u('uA');
		const uB = u('uB');
		const uAlpha = u('uAlpha');

		document.body.prepend(canvas);

		const applyTheme = () => {
			const style = getComputedStyle(document.documentElement);
			gl.uniform3fv(uA, parseColor(style.getPropertyValue('--motion-a') || '#2337ff'));
			gl.uniform3fv(uB, parseColor(style.getPropertyValue('--motion-b') || '#0ea5b7'));
			gl.uniform1f(uAlpha, parseFloat(style.getPropertyValue('--motion-alpha')) || 0.2);
		};

		let dpr = 1;
		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			const w = Math.round(window.innerWidth * dpr);
			const h = Math.round(window.innerHeight * dpr);
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
			}
			gl.viewport(0, 0, w, h);
			gl.uniform2f(uRes, w, h);
			gl.uniform1f(uDpr, dpr);
		};

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		const mouse = { x: -9999, y: -9999, amt: 0, target: 0 };
		window.addEventListener(
			'pointermove',
			(e) => {
				mouse.x = e.clientX;
				mouse.y = e.clientY;
				mouse.target = e.pointerType === 'mouse' ? 1 : 0;
			},
			{ passive: true },
		);
		document.documentElement.addEventListener('pointerleave', () => (mouse.target = 0));

		// wall-clock seconds, wrapped so float precision holds in the shader
		const now = () => (Date.now() / 1000) % 20000;

		const draw = () => {
			mouse.amt += (mouse.target - mouse.amt) * 0.06;
			gl.uniform1f(uTime, now());
			gl.uniform2f(uMouse, mouse.x * dpr, (window.innerHeight - mouse.y) * dpr);
			gl.uniform1f(uMouseAmt, reduced.matches ? 0 : mouse.amt);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		};

		let raf = 0;
		let last = 0;
		const loop = (ts: number) => {
			raf = requestAnimationFrame(loop);
			// the field moves slowly; 30fps is plenty and halves the GPU cost
			if (ts - last < 32) return;
			last = ts;
			draw();
		};
		const run = () => {
			cancelAnimationFrame(raf);
			if (reduced.matches || document.hidden) draw();
			else raf = requestAnimationFrame(loop);
		};

		applyTheme();
		resize();
		draw();
		requestAnimationFrame(() => canvas.classList.add('is-ready'));
		run();

		window.addEventListener('resize', () => {
			resize();
			draw();
		});
		document.addEventListener('visibilitychange', run);
		reduced.addEventListener('change', run);
		const onTheme = () => {
			applyTheme();
			draw();
		};
		new MutationObserver(onTheme).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', onTheme);
	}

	start();
</script>

<style is:global>
	.motion-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		z-index: -1;
		pointer-events: none;
		opacity: 0;
		transition: opacity 1.2s ease;
		/* strongest up top where there's room to breathe, quieter behind long reads */
		mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.55) 60%, rgba(0, 0, 0, 0.35) 100%);
		view-transition-name: motion-bg;
	}
	.motion-bg.is-ready {
		opacity: 1;
	}
	@media print {
		.motion-bg {
			display: none;
		}
	}
</style>

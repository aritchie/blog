---
/*
  An aurora behind every page: ribbons of colour from a domain-warped noise
  field drift slowly across the top of the viewport and settle into a faint
  haze further down. A soft light follows the pointer.

  The field is smooth by nature, so it renders at a fraction of screen
  resolution and lets the browser scale it up - that keeps the GPU cost tiny.
  Colours and strength come from --motion-a/b/c and --motion-alpha in
  global.css, so it follows the theme toggle. Time is wall-clock based, which
  keeps the field continuous across page navigations. No WebGL2 means a static
  CSS gradient instead.
*/
---

<script>
	const VERT = `#version 300 es
in vec2 aPos;
void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;

	const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes;
uniform float uTime;
uniform vec2 uMouse;
uniform float uMouseAmt;
uniform vec3 uA;
uniform vec3 uB;
uniform vec3 uC;
uniform float uAlpha;
out vec4 outColor;

vec2 hash(vec2 p) {
	p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
	return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(dot(hash(i), f), dot(hash(i + vec2(1, 0)), f - vec2(1, 0)), u.x),
		mix(dot(hash(i + vec2(0, 1)), f - vec2(0, 1)), dot(hash(i + vec2(1, 1)), f - vec2(1, 1)), u.x),
		u.y);
}

float fbm(vec2 p) {
	float s = 0.0;
	float a = 0.5;
	mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
	for (int i = 0; i < 5; i++) {
		s += a * noise(p);
		p = m * p;
		a *= 0.5;
	}
	return s;
}

void main() {
	vec2 uv = gl_FragCoord.xy / uRes;
	float aspect = uRes.x / uRes.y;
	vec2 p = vec2(uv.x * aspect, uv.y) * 1.25;
	float t = uTime * 0.025;

	// two rounds of domain warping give the slow, folding ribbon motion
	vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
	vec2 r = vec2(
		fbm(p + 2.2 * q + vec2(1.7, 9.2) + t * 0.7),
		fbm(p + 2.2 * q + vec2(8.3, 2.8) - t * 0.5));
	float f = fbm(p + 2.0 * r);

	vec3 col = mix(uA, uB, smoothstep(-0.25, 0.45, r.x));
	col = mix(col, uC, smoothstep(0.05, 0.55, q.y) * 0.75);

	float intensity = smoothstep(-0.15, 0.6, f + 0.25 * r.y);
	intensity = pow(intensity, 1.4);

	// strongest near the top (GL y is up), a faint haze toward the bottom
	float vertical = smoothstep(0.05, 1.0, uv.y);
	intensity *= mix(0.25, 1.0, vertical);

	// a gentle light that follows the pointer
	vec2 d = (uv - uMouse) * vec2(aspect, 1.0);
	float glow = uMouseAmt * exp(-dot(d, d) * 9.0) * 0.45;
	col = mix(col, mix(uA, uC, 0.5), glow);

	float a = clamp(intensity + glow, 0.0, 1.0) * uAlpha;
	outColor = vec4(col * a, a);
}`;

	// The field has no fine detail, so a fraction of CSS resolution is plenty
	const SCALE = 0.4;

	function parseColor(value: string): [number, number, number] {
		const hex = value.trim().replace('#', '');
		const full = hex.length === 3 ? [...hex].map((c) => c + c).join('') : hex;
		const n = parseInt(full, 16);
		return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
	}

	function compile(gl: WebGL2RenderingContext, type: number, src: string) {
		const shader = gl.createShader(type)!;
		gl.shaderSource(shader, src);
		gl.compileShader(shader);
		if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
			console.warn('[motion-bg]', gl.getShaderInfoLog(shader));
			return null;
		}
		return shader;
	}

	function fallback() {
		document.documentElement.classList.add('no-webgl');
	}

	function start() {
		const canvas = document.createElement('canvas');
		canvas.className = 'motion-bg';
		canvas.setAttribute('aria-hidden', 'true');
		const gl = canvas.getContext('webgl2', {
			antialias: false,
			depth: false,
			premultipliedAlpha: true,
			alpha: true,
		});
		if (!gl) return fallback();

		const vs = compile(gl, gl.VERTEX_SHADER, VERT);
		const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
		if (!vs || !fs) return fallback();
		const program = gl.createProgram()!;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return fallback();
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const aPos = gl.getAttribLocation(program, 'aPos');
		gl.enableVertexAttribArray(aPos);
		gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

		const u = (name: string) => gl.getUniformLocation(program, name);
		const uRes = u('uRes');
		const uTime = u('uTime');
		const uMouse = u('uMouse');
		const uMouseAmt = u('uMouseAmt');
		const uA = u('uA');
		const uB = u('uB');
		const uC = u('uC');
		const uAlpha = u('uAlpha');

		document.body.prepend(canvas);

		const applyTheme = () => {
			const style = getComputedStyle(document.documentElement);
			gl.uniform3fv(uA, parseColor(style.getPropertyValue('--motion-a') || '#7c5cff'));
			gl.uniform3fv(uB, parseColor(style.getPropertyValue('--motion-b') || '#ff6fb1'));
			gl.uniform3fv(uC, parseColor(style.getPropertyValue('--motion-c') || '#ffb15c'));
			gl.uniform1f(uAlpha, parseFloat(style.getPropertyValue('--motion-alpha')) || 0.3);
		};

		const resize = () => {
			const w = Math.max(1, Math.round(window.innerWidth * SCALE));
			const h = Math.max(1, Math.round(window.innerHeight * SCALE));
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
			}
			gl.viewport(0, 0, w, h);
			gl.uniform2f(uRes, w, h);
		};

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		// eased toward the real pointer each frame, so the light glides rather than snaps
		const mouse = { x: 0.5, y: 0.8, tx: 0.5, ty: 0.8, amt: 0, target: 0 };
		window.addEventListener(
			'pointermove',
			(e) => {
				mouse.tx = e.clientX / window.innerWidth;
				mouse.ty = 1 - e.clientY / window.innerHeight;
				mouse.target = e.pointerType === 'mouse' ? 1 : 0;
			},
			{ passive: true },
		);
		document.documentElement.addEventListener('pointerleave', () => (mouse.target = 0));

		// wall-clock seconds, wrapped so float precision holds in the shader
		const now = () => (Date.now() / 1000) % 20000;

		const draw = () => {
			mouse.x += (mouse.tx - mouse.x) * 0.05;
			mouse.y += (mouse.ty - mouse.y) * 0.05;
			mouse.amt += (mouse.target - mouse.amt) * 0.04;
			gl.uniform1f(uTime, now());
			gl.uniform2f(uMouse, mouse.x, mouse.y);
			gl.uniform1f(uMouseAmt, reduced.matches ? 0 : mouse.amt);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		};

		let raf = 0;
		let last = 0;
		const loop = (ts: number) => {
			raf = requestAnimationFrame(loop);
			// the field moves slowly; 30fps is plenty and halves the GPU cost
			if (ts - last < 32) return;
			last = ts;
			draw();
		};
		const run = () => {
			cancelAnimationFrame(raf);
			if (reduced.matches || document.hidden) draw();
			else raf = requestAnimationFrame(loop);
		};

		applyTheme();
		resize();
		draw();
		requestAnimationFrame(() => canvas.classList.add('is-ready'));
		run();

		window.addEventListener('resize', () => {
			resize();
			draw();
		});
		document.addEventListener('visibilitychange', run);
		reduced.addEventListener('change', run);
		const onTheme = () => {
			applyTheme();
			draw();
		};
		new MutationObserver(onTheme).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', onTheme);
	}

	start();
</script>

<style is:global>
	.motion-bg {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		z-index: -2;
		pointer-events: none;
		opacity: 0;
		transition: opacity 1.6s ease;
		view-transition-name: motion-bg;
	}
	.motion-bg.is-ready {
		opacity: 1;
	}

	/* no WebGL2: a still version of the same glow */
	.no-webgl body {
		background-image:
			radial-gradient(60% 40% at 15% 0%, color-mix(in srgb, var(--motion-a) 22%, transparent), transparent 70%),
			radial-gradient(50% 35% at 85% 5%, color-mix(in srgb, var(--motion-b) 18%, transparent), transparent 70%),
			radial-gradient(40% 30% at 55% 0%, color-mix(in srgb, var(--motion-c) 16%, transparent), transparent 70%);
		background-attachment: fixed;
	}

	@media print {
		.motion-bg {
			display: none;
		}
	}
</style>

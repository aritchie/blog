---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	/** Estimated read time in minutes - see src/utils/readingTime.ts */
	minutes?: number;
	/** `featured` puts the art beside the copy and enlarges the type */
	variant?: 'default' | 'featured';
	/** The first card above the fold shouldn't wait for lazy loading */
	eager?: boolean;
}

const { post, minutes, variant = 'default', eager = false } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const href = `/blog/${post.id}/`;
---

<article class:list={['card', `card--${variant}`]}>
	<a class="card-media" href={href} tabindex="-1" aria-hidden="true">
		{
			heroImage && (
				<Image
					src={heroImage}
					alt=""
					width={variant === 'featured' ? 1200 : 720}
					height={variant === 'featured' ? 630 : 378}
					loading={eager ? 'eager' : 'lazy'}
					decoding="async"
				/>
			)
		}
	</a>
	<div class="card-body">
		<p class="card-meta">
			<FormattedDate date={pubDate} />
			{minutes && <><span aria-hidden="true">·</span><span>{minutes} min read</span></>}
		</p>
		<h3><a href={href}>{title}</a></h3>
		<p class="card-desc">{description}</p>
		{
			tags && tags.length > 0 && (
				<ul class="card-tags" role="list">
					{tags.slice(0, 3).map((tag) => (
						<li>
							<a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		box-shadow: 0 1px 2px rgba(var(--shadow), 12%);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.card:hover {
			transform: translateY(-3px);
			border-color: var(--accent);
			box-shadow: 0 10px 30px rgba(var(--shadow), 22%);
		}
	}

	.card-media {
		display: block;
		aspect-ratio: 1200 / 630;
		overflow: hidden;
		background: #0f172a;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.card-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		border-radius: 0;
	}

	.card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.1rem 1.2rem 1.2rem;
	}
	.card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
		font-size: 0.72rem;
		color: rgb(var(--gray));
	}
	.card h3 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.25;
		letter-spacing: -0.02em;
		text-wrap: pretty;
	}
	.card h3 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	/* the whole card is clickable, but only the title is in the tab order */
	.card h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card {
		position: relative;
	}
	.card h3 a:hover {
		color: var(--accent);
	}
	.card-desc {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.55;
		color: rgb(var(--gray-dark));
		text-wrap: pretty;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.35rem 0 0;
		padding: 0;
	}
	.card-tags li {
		list-style: none;
	}
	.card-tags a {
		/* lift the tag links above the title's full-card overlay */
		position: relative;
		z-index: 1;
		display: inline-block;
		padding: 0.2rem 0.55rem;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1.3;
		text-decoration: none;
		color: var(--accent-dark);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		border-radius: 999px;
	}
	.card-tags a:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	/* ---------- featured ---------- */

	@media (min-width: 900px) {
		.card--featured {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		}
		.card--featured .card-media {
			height: 100%;
			aspect-ratio: auto;
			border-right: 1px solid rgb(var(--gray-light));
			border-bottom: 0;
		}
		.card--featured .card-body {
			gap: 0.65rem;
			padding: 1.9rem;
		}
		.card--featured h3 {
			font-size: 1.9rem;
		}
		.card--featured .card-desc {
			font-size: 0.98rem;
			-webkit-line-clamp: 5;
			line-clamp: 5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
		.card:hover {
			transform: none;
		}
	}
</style>

---
import type { ReadingProgressDock } from '../consts';

interface Props {
	/** Estimated minutes to read - see src/utils/readingTime.ts */
	minutes: number;
	/** Where the bar sticks to the viewport */
	dock?: ReadingProgressDock;
	/** Selector for the element progress is measured against */
	target?: string;
}

const { minutes, dock = 'top', target = 'article' } = Astro.props;
---

<div
	class="reading-progress"
	data-reading-progress
	data-dock={dock}
	data-minutes={minutes}
	data-target={target}
	role="progressbar"
	aria-label="Reading progress"
	aria-valuemin="0"
	aria-valuemax="100"
	aria-valuenow="0"
>
	<div class="rp-track"><div class="rp-fill"></div></div>
	<div class="rp-meta">
		<span class="rp-read">
			<svg class="rp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path
					d="M12 6.5C10.5 5.2 8.6 4.5 6.5 4.5c-1 0-2 .15-2.9.45A.9.9 0 0 0 3 5.8v11.6c0 .6.6 1.05 1.2.87.72-.2 1.5-.3 2.3-.3 2 0 3.9.7 5.5 2 1.6-1.3 3.5-2 5.5-2 .8 0 1.58.1 2.3.3.6.18 1.2-.27 1.2-.87V5.8a.9.9 0 0 0-.6-.85c-.9-.3-1.9-.45-2.9-.45-2.1 0-4 .7-5.5 2Zm0 0v12"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span>{minutes} min read</span>
		</span>
		<span class="rp-left" data-rp-left aria-live="off"></span>
	</div>
</div>

<style>
	.reading-progress {
		position: fixed;
		left: 0;
		right: 0;
		z-index: 1001;
		display: flex;
		flex-direction: column;
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		font-size: 0.7rem;
		line-height: 1;
		color: rgb(var(--gray));
		pointer-events: none;
	}

	.reading-progress[data-dock='top'] {
		top: var(--reading-progress-offset, 0px);
		border-bottom: 1px solid rgba(var(--gray-light), 90%);
		box-shadow: 0 2px 10px rgba(var(--black), 5%);
	}

	/* bottom dock reads better with the bar on the outer edge */
	.reading-progress[data-dock='bottom'] {
		bottom: 0;
		flex-direction: column-reverse;
		border-top: 1px solid rgba(var(--gray-light), 90%);
		box-shadow: 0 -2px 10px rgba(var(--black), 5%);
	}

	.rp-track {
		height: 3px;
		width: 100%;
		background: rgba(var(--gray-light), 70%);
	}

	.rp-fill {
		height: 100%;
		width: 0;
		background: linear-gradient(90deg, var(--accent), var(--accent-dark));
		transform-origin: left center;
		transition: width 0.1s linear;
	}

	.rp-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 0.45em 0;
	}

	.rp-read {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-weight: 600;
	}

	.rp-icon {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		color: var(--accent);
	}

	.rp-left {
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.rp-left:not(:empty) {
		opacity: 0.85;
	}

	@media (prefers-reduced-motion: reduce) {
		.rp-fill,
		.rp-left {
			transition: none;
		}
	}

	@media print {
		.reading-progress {
			display: none;
		}
	}

	/* keep the footer clear of a bottom-docked bar */
	:global(body.has-bottom-reading-progress) {
		padding-bottom: 3.5rem;
	}
</style>

<script>
	function initReadingProgress(el: HTMLElement) {
		const fill = el.querySelector<HTMLElement>('.rp-fill');
		const left = el.querySelector<HTMLElement>('[data-rp-left]');
		const minutes = Number(el.dataset.minutes) || 0;
		const target =
			document.querySelector<HTMLElement>(el.dataset.target || 'article') ??
			document.querySelector<HTMLElement>('article') ??
			document.body;

		if (el.dataset.dock === 'bottom') {
			document.body.classList.add('has-bottom-reading-progress');
		}

		// a top-docked bar sits directly under the sticky site header
		const header = document.querySelector<HTMLElement>('header');
		const updateOffset = () => {
			if (el.dataset.dock !== 'top') return;
			const offset = header ? header.getBoundingClientRect().height : 0;
			el.style.setProperty('--reading-progress-offset', `${offset}px`);
			// keep anchor targets from landing behind the header + bar
			document.documentElement.style.scrollPaddingTop = `${offset + el.offsetHeight}px`;
		};

		let ticking = false;
		const update = () => {
			ticking = false;
			const rect = target.getBoundingClientRect();
			const start = rect.top + window.scrollY;
			const distance = target.offsetHeight - window.innerHeight;
			const scrolled = window.scrollY - start;
			const ratio = distance > 0 ? scrolled / distance : scrolled > 0 ? 1 : 0;
			const progress = Math.min(1, Math.max(0, ratio));
			const percent = Math.round(progress * 100);

			if (fill) fill.style.width = `${percent}%`;
			el.setAttribute('aria-valuenow', String(percent));

			if (left) {
				const remaining = Math.ceil(minutes * (1 - progress));
				left.textContent =
					percent < 2 ? '' : percent >= 99 || remaining <= 0 ? 'Finished' : `${remaining} min left`;
			}
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		updateOffset();
		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => {
			updateOffset();
			onScroll();
		});

		if ('ResizeObserver' in window) {
			// article height changes (images, embedded comments) shift the geometry
			const observer = new ResizeObserver(() => {
				updateOffset();
				onScroll();
			});
			observer.observe(target);
			if (header) observer.observe(header);
		}
	}

	document
		.querySelectorAll<HTMLElement>('[data-reading-progress]')
		.forEach((el) => initReadingProgress(el));
</script>

---
import type { ReadingProgressDock } from '../consts';

interface Props {
	/** Estimated minutes to read - see src/utils/readingTime.ts */
	minutes: number;
	/** Where the bar sticks to the viewport */
	dock?: ReadingProgressDock;
	/** Selector for the element progress is measured against */
	target?: string;
}

const { minutes, dock = 'top', target = 'article' } = Astro.props;
---

<div
	class="reading-progress"
	data-reading-progress
	data-dock={dock}
	data-minutes={minutes}
	data-target={target}
	role="progressbar"
	aria-label="Reading progress"
	aria-valuemin="0"
	aria-valuemax="100"
	aria-valuenow="0"
>
	<div class="rp-track"><div class="rp-fill"></div></div>
	<div class="rp-meta">
		<span class="rp-read">
			<svg class="rp-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path
					d="M12 6.5C10.5 5.2 8.6 4.5 6.5 4.5c-1 0-2 .15-2.9.45A.9.9 0 0 0 3 5.8v11.6c0 .6.6 1.05 1.2.87.72-.2 1.5-.3 2.3-.3 2 0 3.9.7 5.5 2 1.6-1.3 3.5-2 5.5-2 .8 0 1.58.1 2.3.3.6.18 1.2-.27 1.2-.87V5.8a.9.9 0 0 0-.6-.85c-.9-.3-1.9-.45-2.9-.45-2.1 0-4 .7-5.5 2Zm0 0v12"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span>{minutes} min read</span>
		</span>
		<span class="rp-left" data-rp-left aria-live="off"></span>
	</div>
</div>

<style>
	/* A hairline of brand gradient along the viewport edge, plus a floating chip
	   that counts down the minutes once reading begins. */
	.reading-progress {
		position: fixed;
		left: 0;
		right: 0;
		z-index: 1001;
		height: 0;
		font-size: 0.72rem;
		line-height: 1;
		color: rgb(var(--gray-dark));
		pointer-events: none;
	}
	.reading-progress[data-dock='top'] {
		top: 0;
	}
	.reading-progress[data-dock='bottom'] {
		bottom: 0;
	}

	.rp-track {
		position: absolute;
		left: 0;
		right: 0;
		height: 3px;
	}
	.reading-progress[data-dock='bottom'] .rp-track {
		bottom: 0;
	}
	.rp-fill {
		height: 100%;
		width: 0;
		background: var(--grad);
		border-radius: 0 3px 3px 0;
		box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
		transition: width 0.12s linear;
	}

	.rp-meta {
		position: fixed;
		right: clamp(0.75rem, 2vw, 1.5rem);
		bottom: clamp(0.75rem, 2vw, 1.5rem);
		display: flex;
		align-items: center;
		gap: 0.75em;
		padding: 0.6em 0.95em;
		font-family: var(--font-mono);
		background: var(--glass);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
		backdrop-filter: blur(16px) saturate(160%);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		box-shadow: var(--card-shadow-hover);
		opacity: 0;
		transform: translateY(12px) scale(0.96);
		transition:
			opacity 0.4s ease,
			transform 0.5s var(--ease-spring);
	}
	.reading-progress[data-dock='bottom'] .rp-meta {
		bottom: calc(clamp(0.75rem, 2vw, 1.5rem) + 6px);
	}
	.reading-progress.is-reading .rp-meta {
		opacity: 1;
		transform: none;
	}

	.rp-read {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
	}
	.rp-icon {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		color: var(--accent);
	}
	.rp-left {
		padding-left: 0.75em;
		border-left: 1px solid var(--border-strong);
		color: rgb(var(--black));
	}
	.rp-left:empty {
		display: none;
	}

	@media print {
		.reading-progress {
			display: none;
		}
	}
</style>

<script>
	function initReadingProgress(el: HTMLElement) {
		const fill = el.querySelector<HTMLElement>('.rp-fill');
		const left = el.querySelector<HTMLElement>('[data-rp-left]');
		const minutes = Number(el.dataset.minutes) || 0;
		const target =
			document.querySelector<HTMLElement>(el.dataset.target || 'article') ??
			document.querySelector<HTMLElement>('article') ??
			document.body;

		if (el.dataset.dock === 'bottom') {
			document.body.classList.add('has-bottom-reading-progress');
		}

		// a top-docked bar sits directly under the sticky site header
		const header = document.querySelector<HTMLElement>('header');
		const updateOffset = () => {
			if (el.dataset.dock !== 'top') return;
			const offset = header ? header.getBoundingClientRect().height : 0;
			// keep anchor targets from landing behind the header + bar
			document.documentElement.style.scrollPaddingTop = `${offset + 16}px`;
		};

		let ticking = false;
		const update = () => {
			ticking = false;
			const rect = target.getBoundingClientRect();
			const start = rect.top + window.scrollY;
			const distance = target.offsetHeight - window.innerHeight;
			const scrolled = window.scrollY - start;
			const ratio = distance > 0 ? scrolled / distance : scrolled > 0 ? 1 : 0;
			const progress = Math.min(1, Math.max(0, ratio));
			const percent = Math.round(progress * 100);

			if (fill) fill.style.width = `${percent}%`;
			el.classList.toggle('is-reading', percent >= 2);
			el.setAttribute('aria-valuenow', String(percent));

			if (left) {
				const remaining = Math.ceil(minutes * (1 - progress));
				left.textContent =
					percent < 2 ? '' : percent >= 99 || remaining <= 0 ? 'Finished' : `${remaining} min left`;
			}
		};

		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		updateOffset();
		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => {
			updateOffset();
			onScroll();
		});

		if ('ResizeObserver' in window) {
			// article height changes (images, embedded comments) shift the geometry
			const observer = new ResizeObserver(() => {
				updateOffset();
				onScroll();
			});
			observer.observe(target);
			if (header) observer.observe(header);
		}
	}

	document
		.querySelectorAll<HTMLElement>('[data-reading-progress]')
		.forEach((el) => initReadingProgress(el));
</script>

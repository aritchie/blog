---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import logo from '../assets/logo.png';

const year = new Date().getFullYear();

const columns = [
	{
		title: 'Site',
		links: [
			{ label: 'Blog', href: '/' },
			{ label: 'Projects', href: '/projects/' },
			{ label: 'Speaking', href: '/speaking/' },
			{ label: 'About', href: '/about/' },
			{ label: 'RSS feed', href: '/rss.xml' },
		],
	},
	{
		title: 'Open source',
		links: [
			{ label: 'Shiny docs', href: 'https://shinylib.net', external: true },
			{ label: 'GitHub', href: 'https://github.com/aritchie', external: true },
			{ label: 'NuGet · aritchie', href: 'https://nuget.org/profiles/aritchie', external: true },
			{ label: 'NuGet · ShinyLib', href: 'https://nuget.org/profiles/ShinyLib', external: true },
			{ label: 'Sponsor', href: 'https://github.com/sponsors/aritchie', external: true },
		],
	},
	{
		title: 'Elsewhere',
		links: [
			{ label: 'ShinySoft Technologies', href: 'https://shinysoft.biz', external: true },
			{ label: 'Gone .NET', href: 'https://www.gonedotnet.io', external: true },
			{ label: 'YouTube', href: 'https://www.youtube.com/@GoneDotNet', external: true },
			{ label: 'Email me', href: 'mailto:allan@shinysoft.biz' },
		],
	},
];
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a class="brand" href="/">
				<Image src={logo} alt="" width={64} height={64} loading="lazy" />
				<span>{SITE_TITLE}</span>
			</a>
			<p class="tagline">{SITE_DESCRIPTION}.</p>
			<SocialLinks />
		</div>

		<nav class="footer-nav" aria-label="Footer">
			{
				columns.map((column) => (
					<div class="footer-col">
						<h2>{column.title}</h2>
						<ul role="list">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										target={link.external ? '_blank' : undefined}
										rel={link.external ? 'noopener noreferrer' : undefined}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>

	<div class="footer-base">
		<p>&copy; {year} Allan Ritchie. All rights reserved.</p>
		<p>
			Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>,
			hosted on GitHub Pages.
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: clamp(2.5rem, 5vw, 3.5rem) 1.25rem 2.5rem;
		color: rgb(var(--gray-dark));
		background: var(--surface-2);
		border-top: 1px solid rgb(var(--gray-light));
	}

	.footer-inner {
		display: grid;
		gap: 2.5rem;
		width: min(1160px, 100%);
		margin: 0 auto;
	}
	@media (min-width: 820px) {
		.footer-inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
			gap: 3rem;
		}
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand :global(img) {
		width: 30px;
		height: 30px;
		border-radius: 8px;
		margin: 0;
	}
	.tagline {
		max-width: 34ch;
		margin: 0.7rem 0 1.1rem;
		font-size: 0.9rem;
		line-height: 1.55;
		color: rgb(var(--gray));
		text-wrap: pretty;
	}
	/* Same cluster as the header: one plate, tight gap, a pill per icon on hover */
	.footer-brand :global(.social-links) {
		--social-icon-size: 18px;
		--social-gap: 0.1rem;
		--social-margin-top: 0;
		width: fit-content;
		max-width: 100%;
		flex-wrap: wrap;
		padding: 0.25rem 0.35rem;
		border-radius: 999px;
		background: rgba(var(--gray-light), 55%);
	}
	.footer-brand :global(.social-links a) {
		padding: 0.35rem;
		border-radius: 8px;
	}
	.footer-brand :global(.social-links a:hover) {
		background: var(--surface);
	}

	.footer-nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1.75rem;
	}
	.footer-col h2 {
		margin: 0 0 0.7rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}
	.footer-col li {
		list-style: none;
	}
	.footer-col a {
		font-size: 0.88rem;
		line-height: 1.4;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.footer-col a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.footer-base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		width: min(1160px, 100%);
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.footer-base p {
		margin: 0;
	}
	.footer-base a {
		color: inherit;
		text-decoration: underline;
	}
	.footer-base a:hover {
		color: var(--accent);
	}
</style>

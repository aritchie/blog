---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import logo from '../assets/logo.png';

const year = new Date().getFullYear();

const columns = [
	{
		title: 'Site',
		links: [
			{ label: 'Blog', href: '/' },
			{ label: 'Projects', href: '/projects/' },
			{ label: 'Speaking', href: '/speaking/' },
			{ label: 'About', href: '/about/' },
			{ label: 'RSS feed', href: '/rss.xml' },
		],
	},
	{
		title: 'Open source',
		links: [
			{ label: 'Shiny docs', href: 'https://shinylib.net', external: true },
			{ label: 'GitHub', href: 'https://github.com/aritchie', external: true },
			{ label: 'NuGet · aritchie', href: 'https://nuget.org/profiles/aritchie', external: true },
			{ label: 'NuGet · ShinyLib', href: 'https://nuget.org/profiles/ShinyLib', external: true },
			{ label: 'Sponsor', href: 'https://github.com/sponsors/aritchie', external: true },
		],
	},
	{
		title: 'Elsewhere',
		links: [
			{ label: 'ShinySoft Technologies', href: 'https://shinysoft.biz', external: true },
			{ label: 'Gone .NET', href: 'https://www.gonedotnet.io', external: true },
			{ label: 'YouTube', href: 'https://www.youtube.com/@GoneDotNet', external: true },
			{ label: 'Email me', href: 'mailto:allan@shinysoft.biz' },
		],
	},
];
---

<footer>
	<div class="footer-panel" data-reveal>
		<div class="footer-inner">
			<div class="footer-brand">
				<a class="brand" href="/">
					<span class="brand-mark">
						<Image src={logo} alt="" width={64} height={64} loading="lazy" />
					</span>
					<span>{SITE_TITLE}</span>
				</a>
				<p class="tagline">{SITE_DESCRIPTION}.</p>
				<SocialLinks />
			</div>

			<nav class="footer-nav" aria-label="Footer">
				{
					columns.map((column) => (
						<div class="footer-col">
							<h2>{column.title}</h2>
							<ul role="list">
								{column.links.map((link) => (
									<li>
										<a
											href={link.href}
											target={link.external ? '_blank' : undefined}
											rel={link.external ? 'noopener noreferrer' : undefined}
										>
											<span>{link.label}</span>
											{link.external && (
												<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
													<path
														d="M7 17 17 7M9 7h8v8"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
											)}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</div>

		<p class="wordmark" aria-hidden="true">Allan Ritchie</p>

		<div class="footer-base">
			<p>&copy; {year} Allan Ritchie. All rights reserved.</p>
			<p>
				Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>,
				hosted on GitHub Pages.
			</p>
			<a class="to-top" href="#" data-to-top>
				<span>Back to top</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						d="M12 19V5M6 11l6-6 6 6"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>

<script>
	document.querySelector('[data-to-top]')?.addEventListener('click', (event) => {
		event.preventDefault();
		window.scrollTo({ top: 0 });
	});
</script>

<style>
	footer {
		margin-top: clamp(4rem, 8vw, 7rem);
		padding: 0 clamp(0.75rem, 2vw, 1.25rem) clamp(0.75rem, 2vw, 1.25rem);
	}

	.footer-panel {
		position: relative;
		width: min(1200px, 100%);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(1.25rem, 2.5vw, 1.75rem);
		overflow: hidden;
		color: rgb(var(--gray-dark));
		background: color-mix(in srgb, var(--surface) 78%, transparent);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		border: 1px solid var(--border);
		border-radius: calc(var(--radius-lg) + 8px);
		box-shadow: inset 0 1px 0 var(--glass-edge);
	}
	/* a band of brand colour along the top edge */
	.footer-panel::before {
		content: '';
		position: absolute;
		inset: 0 12% auto;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent), var(--accent-2), var(--accent-3), transparent);
		opacity: 0.9;
	}

	.footer-inner {
		display: grid;
		gap: 2.5rem;
	}
	@media (min-width: 820px) {
		.footer-inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
			gap: 3rem;
		}
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 1.1rem;
		font-weight: 650;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		width: 36px;
		height: 36px;
		padding: 2px;
		border-radius: 50%;
		background: var(--grad);
	}
	.brand :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		margin: 0;
		background: var(--surface);
	}
	.tagline {
		max-width: 34ch;
		margin: 0.85rem 0 1.25rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-style: italic;
		line-height: 1.2;
		color: rgb(var(--gray-dark));
		text-wrap: pretty;
	}
	.footer-brand :global(.social-links) {
		--social-icon-size: 17px;
		--social-gap: 0.15rem;
		--social-margin-top: 0;
		justify-content: flex-start;
		flex-wrap: wrap;
	}
	.footer-brand :global(.social-links a) {
		padding: 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--glass);
	}
	.footer-brand :global(.social-links a:hover) {
		border-color: var(--border-strong);
		background: var(--surface);
	}

	.footer-nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1.75rem;
	}
	.footer-col h2 {
		margin: 0 0 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin: 0;
		padding: 0;
	}
	.footer-col li {
		list-style: none;
	}
	.footer-col a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.92rem;
		line-height: 1.4;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition:
			color 0.2s ease,
			transform 0.3s var(--ease-out);
	}
	.footer-col a svg {
		width: 0.8rem;
		height: 0.8rem;
		opacity: 0;
		transform: translate(-4px, 4px);
		transition:
			opacity 0.2s ease,
			transform 0.3s var(--ease-out);
	}
	.footer-col a:hover {
		color: rgb(var(--black));
		transform: translateX(3px);
	}
	.footer-col a:hover svg {
		opacity: 1;
		transform: none;
	}

	/* An oversized wordmark that bleeds off the panel - pure decoration */
	.wordmark {
		margin: clamp(2rem, 5vw, 3.5rem) 0 0;
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 13.5vw, 11rem);
		line-height: 0.85;
		letter-spacing: -0.03em;
		text-align: center;
		white-space: nowrap;
		color: transparent;
		background: linear-gradient(180deg, rgba(var(--black), 0.14), rgba(var(--black), 0.02) 85%);
		-webkit-background-clip: text;
		background-clip: text;
		user-select: none;
	}

	.footer-base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.footer-base p {
		margin: 0;
	}
	.footer-base a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.footer-base a:hover {
		color: var(--accent);
	}
	.footer-base .to-top {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.75rem;
		font-weight: 500;
		text-decoration: none;
		border: 1px solid var(--border);
		border-radius: 999px;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.to-top svg {
		width: 0.9rem;
		height: 0.9rem;
		transition: transform 0.35s var(--ease-spring);
	}
	.footer-base .to-top:hover {
		border-color: var(--accent);
	}
	.to-top:hover svg {
		transform: translateY(-3px);
	}
</style>

---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import gonedotnet from '../assets/gonedotnet.jpg';
import {
	FIRST_YEAR,
	FORMATS,
	RECORDED_TALKS,
	TOPICS,
	TOTAL_TALKS,
	talksByYear,
} from '../data/talks';

const title = 'Speaking';
const description =
	'Conference talks, community standups, user groups and live streams by Allan Ritchie — and how to book me for your event.';

const years = talksByYear();
const currentYear = new Date().getFullYear();
const yearsSpeaking = currentYear - Number(FIRST_YEAR) + 1;

const formatDate = (iso: string, monthOnly?: boolean) =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
		month: 'long',
		...(monthOnly ? {} : { day: 'numeric' }),
		year: 'numeric',
		timeZone: 'UTC',
	});
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<p class="eyebrow">Speaking</p>
				<h1>Talks &amp; appearances</h1>
				<p class="lede">
					I've been talking about .NET, mobile and open source since {FIRST_YEAR} — on conference
					stages, community standups, user groups and a lot of live streams. If your event needs a
					speaker, I'd love to hear from you.
				</p>
				<dl class="stats">
					<div><dt>Talks</dt><dd>{TOTAL_TALKS}</dd></div>
					<div><dt>Years speaking</dt><dd>{yearsSpeaking}</dd></div>
					<div><dt>Recorded</dt><dd>{RECORDED_TALKS}</dd></div>
				</dl>
			</header>

			<section class="invite" aria-labelledby="invite-title">
				<div class="invite-copy">
					<h2 id="invite-title">Have me speak at your event</h2>
					<p>
						User group, conference, podcast or company lunch-and-learn — I'm happy to travel or dial
						in. I talk about my open source work, .NET in general, and 25 years of shipping software
						the hard way.
					</p>
					<ul class="topics" role="list">
						{TOPICS.map((topic) => <li>{topic}</li>)}
					</ul>
					<div class="invite-actions">
						<a class="btn btn--primary" href="mailto:allan@shinysoft.biz?subject=Speaking%20enquiry">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<rect
									x="3"
									y="5"
									width="18"
									height="14"
									rx="2"
									fill="none"
									stroke="currentColor"
									stroke-width="2"></rect>
								<path
									d="m3.5 7 8.5 6 8.5-6"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							<span>Get in touch</span>
						</a>
						<a
							class="btn btn--secondary"
							href="https://github.com/aritchie/talks"
							target="_blank"
							rel="noopener noreferrer"
						>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
									fill="currentColor"></path>
							</svg>
							<span>Slides &amp; samples</span>
						</a>
					</div>
				</div>

				<aside class="show" aria-labelledby="show-title">
					<a class="show-media" href="https://www.youtube.com/@GoneDotNet" target="_blank" rel="noopener noreferrer">
						<Image src={gonedotnet} alt="Gone .NET" width={640} densities={[1, 2]} />
					</a>
					<div class="show-copy">
						<p class="show-flag">Weekly · live</p>
						<h2 id="show-title">Gone .NET</h2>
						<p>
							Every week I go beyond the basics with my good friend <a
								href="https://x.com/redth"
								target="_blank"
								rel="noopener noreferrer">Jonathan Dick</a
							> — building real .NET samples and digging through the ecosystem live.
						</p>
						<div class="show-links">
							<a
								class="btn btn--primary"
								href="https://www.youtube.com/@GoneDotNet"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path
										d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8M10 15V9l5.2 3Z"
										fill="currentColor"></path>
								</svg>
								<span>Watch on YouTube</span>
							</a>
							<a
								class="btn btn--secondary"
								href="https://www.gonedotnet.io"
								target="_blank"
								rel="noopener noreferrer"><span>www.gonedotnet.io</span></a
							>
						</div>
					</div>
				</aside>
			</section>

			<section class="archive" aria-labelledby="archive-title">
				<header class="archive-head">
					<div class="archive-heading">
						<h2 id="archive-title">Past talks</h2>
						<span class="archive-count" data-count aria-live="polite">{TOTAL_TALKS} talks</span>
					</div>
					<div class="filters" role="group" aria-label="Filter by format">
						{
							FORMATS.map((format) => (
								<button type="button" class="chip" data-format={format} aria-pressed="false">
									{format}
								</button>
							))
						}
						<button type="button" class="chip chip--clear" data-clear hidden>Clear</button>
					</div>
				</header>

				<p class="empty-state" data-empty hidden>Nothing in that format yet.</p>

				{
					years.map(({ year, items }) => (
						<section class="year" data-year aria-label={`Talks from ${year}`}>
							<h3 class="year-marker">{year}</h3>
							<ol class="timeline" role="list">
								{items.map((talk) => (
									<li
										class="entry"
										data-talk
										data-format={talk.format}
									>
										<article>
											<div class="entry-meta">
												<time datetime={talk.date}>{formatDate(talk.date, talk.monthOnly)}</time>
												<span class="format" data-format-badge={talk.format}>
													{talk.format}
												</span>
											</div>
											<h4>{talk.title ?? talk.event}</h4>
											{talk.title && <p class="entry-event">{talk.event}</p>}
											{talk.links && (
												<div class="entry-links">
													{talk.links.map((link) => (
														<a href={link.href} target="_blank" rel="noopener noreferrer">
															<span>{link.label}</span>
															<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
																<path
																	d="M7 17 17 7M9 7h8v8"
																	fill="none"
																	stroke="currentColor"
																	stroke-width="2"
																	stroke-linecap="round"
																	stroke-linejoin="round"
																/>
															</svg>
															<span class="sr-only">
																{talk.title ?? talk.event} on {link.label}
															</span>
														</a>
													))}
												</div>
											)}
										</article>
									</li>
								))}
							</ol>
						</section>
					))
				}
			</section>
		</main>
		<Footer />

		<script>
			const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-format]'))
				.filter((el): el is HTMLButtonElement => el.tagName === 'BUTTON');
			const clear = document.querySelector<HTMLButtonElement>('[data-clear]');
			const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-talk]'));
			const yearBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-year]'));
			const countEl = document.querySelector<HTMLElement>('[data-count]');
			const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
			const total = entries.length;

			const active = new Set<string>();

			function apply() {
				let visible = 0;
				for (const entry of entries) {
					// no selection means everything, otherwise OR across the chosen formats
					const show = active.size === 0 || active.has(entry.dataset.format ?? '');
					entry.hidden = !show;
					if (show) visible++;
				}
				for (const block of yearBlocks) {
					block.hidden = block.querySelectorAll('[data-talk]:not([hidden])').length === 0;
				}
				if (countEl) {
					countEl.textContent =
						active.size === 0
							? `${total} talks`
							: `${visible} of ${total} talk${total === 1 ? '' : 's'}`;
				}
				if (emptyEl) emptyEl.hidden = visible !== 0;
				if (clear) clear.hidden = active.size === 0;
			}

			for (const chip of chips) {
				chip.addEventListener('click', () => {
					const format = chip.dataset.format!;
					const next = !active.has(format);
					if (next) active.add(format);
					else active.delete(format);
					chip.setAttribute('aria-pressed', String(next));
					apply();
				});
			}

			clear?.addEventListener('click', () => {
				active.clear();
				for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
				apply();
			});

			apply();
		</script>

		<style>
			main {
				width: min(1080px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0 0 5rem;
			}

			/* ---------- page head ---------- */

			.page-head {
				padding: 3.5rem 0 2.5rem;
			}
			.eyebrow {
				margin: 0 0 0.5rem;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.page-head h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(2.4rem, 1.8rem + 2.8vw, 4rem);
				letter-spacing: -0.03em;
				text-wrap: balance;
			}
			.lede {
				max-width: 62ch;
				margin: 0;
				font-size: 1.05rem;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}
			.stats {
				display: flex;
				flex-wrap: wrap;
				gap: 2.5rem;
				margin: 2rem 0 0;
			}
			.stats dt {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.stats dd {
				margin: 0.15rem 0 0;
				font-size: 1.7rem;
				font-weight: 700;
				line-height: 1;
				color: rgb(var(--black));
			}

			/* ---------- invite + show ---------- */

			.invite {
				display: grid;
				gap: 1.25rem;
				margin-top: 1rem;
			}
			@media (min-width: 900px) {
				.invite {
					grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
					align-items: stretch;
				}
			}

			.invite-copy {
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: clamp(1.4rem, 3vw, 2.1rem);
				color: #f8fafc;
				background:
					radial-gradient(120% 120% at 0% 0%, rgba(99, 102, 241, 0.55), transparent 60%),
					linear-gradient(135deg, #0b1020, #161c3d 55%, #0b1020);
				border-radius: 16px;
			}
			.invite-copy h2 {
				margin: 0 0 0.6rem;
				font-size: clamp(1.7rem, 1.4rem + 1.2vw, 2.4rem);
				letter-spacing: -0.03em;
				color: #fff;
				text-wrap: balance;
			}
			.invite-copy p {
				max-width: 46ch;
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.55;
				color: rgba(248, 250, 252, 0.82);
				text-wrap: pretty;
			}
			.topics {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 1.2rem 0 0;
				padding: 0;
			}
			.topics li {
				list-style: none;
				padding: 0.3rem 0.6rem;
				font-size: 0.75rem;
				line-height: 1.3;
				color: rgba(248, 250, 252, 0.92);
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.16);
				border-radius: 999px;
			}
			.invite-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1.6rem;
			}
			.invite-copy .btn--primary {
				background: #fff;
				border-color: #fff;
				color: #0b1020;
			}
			.invite-copy .btn--primary:hover {
				background: rgba(255, 255, 255, 0.86);
				border-color: rgba(255, 255, 255, 0.86);
				color: #0b1020;
			}
			.invite-copy .btn--secondary {
				background: transparent;
				border-color: rgba(255, 255, 255, 0.34);
				color: #f8fafc;
			}
			.invite-copy .btn--secondary:hover {
				border-color: #fff;
				background: rgba(255, 255, 255, 0.08);
				color: #fff;
			}

			.show {
				display: flex;
				flex-direction: column;
				overflow: hidden;
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
			}
			.show-media {
				display: block;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: rgba(var(--gray-light), 50%);
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.show-media :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				margin: 0;
				transition: transform 0.3s ease;
			}
			@media (hover: hover) and (pointer: fine) {
				.show-media:hover :global(img) {
					transform: scale(1.03);
				}
			}
			.show-copy {
				display: flex;
				flex: 1;
				flex-direction: column;
				gap: 0.55rem;
				padding: clamp(1.1rem, 2vw, 1.5rem);
			}
			.show-flag {
				margin: 0;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.show-copy h2 {
				margin: 0;
				font-size: 1.6rem;
				letter-spacing: -0.02em;
			}
			.show-copy p {
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
				text-wrap: pretty;
			}
			.show-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: auto;
				padding-top: 0.85rem;
			}

			/* ---------- shared buttons ---------- */

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.55rem 0.9rem;
				font-size: 0.85rem;
				font-weight: 700;
				line-height: 1;
				text-decoration: none;
				border: 1px solid transparent;
				border-radius: 8px;
				transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
			}
			.btn svg {
				flex: 0 0 auto;
				width: 1rem;
				height: 1rem;
			}
			.btn--primary {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}
			.btn--primary:hover {
				background: var(--accent-dark);
				border-color: var(--accent-dark);
				color: #fff;
			}
			.btn--secondary {
				background: #fff;
				border-color: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.btn--secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* ---------- archive ---------- */

			.archive {
				margin-top: clamp(3.5rem, 6vw, 5rem);
			}
			.archive-head {
				display: grid;
				gap: 1rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.archive-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
			}
			.archive-heading h2 {
				margin: 0;
				font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem);
				letter-spacing: -0.03em;
			}
			.archive-count {
				flex: 0 0 auto;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--accent);
				white-space: nowrap;
			}
			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.chip {
				padding: 0.35rem 0.7rem;
				font-family: inherit;
				font-size: 0.78rem;
				font-weight: 700;
				line-height: 1;
				color: rgb(var(--gray-dark));
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.chip:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.chip[aria-pressed='true'] {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}
			.chip--clear {
				color: rgb(var(--gray));
				border-style: dashed;
			}

			.empty-state {
				margin: 3rem 0;
				text-align: center;
				color: rgb(var(--gray));
			}

			/* ---------- timeline ---------- */

			.year {
				display: grid;
				gap: 0.5rem 2rem;
				padding-top: 2.25rem;
			}
			/* `display: grid` outranks the UA's [hidden] rule, so say it explicitly */
			.year[hidden] {
				display: none;
			}
			@media (min-width: 820px) {
				.year {
					grid-template-columns: 6rem minmax(0, 1fr);
				}
				.year-marker {
					position: sticky;
					top: 90px;
					align-self: start;
					text-align: right;
				}
			}
			.year-marker {
				margin: 0;
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1;
				color: rgb(var(--gray));
				letter-spacing: -0.02em;
			}

			.timeline {
				margin: 0;
				padding: 0 0 0 1.6rem;
				list-style: none;
				border-left: 2px solid rgb(var(--gray-light));
			}
			.entry {
				position: relative;
				padding: 0 0 1.6rem;
			}
			.entry:last-child {
				padding-bottom: 0;
			}
			/* the dot on the rail */
			.entry::before {
				content: '';
				position: absolute;
				top: 0.55rem;
				left: calc(-1.6rem - 6px);
				width: 10px;
				height: 10px;
				background: #fff;
				border: 2px solid rgb(var(--gray-light));
				border-radius: 50%;
				transition: border-color 0.2s ease, background-color 0.2s ease;
			}
			@media (hover: hover) and (pointer: fine) {
				.entry:hover::before {
					border-color: var(--accent);
					background: var(--accent);
				}
			}
			.entry-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.25rem;
			}
			.entry-meta time {
				font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
				font-size: 0.74rem;
				color: rgb(var(--gray));
			}
			.format {
				padding: 0.15rem 0.45rem;
				font-size: 0.66rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: rgb(var(--gray-dark));
				background: rgba(var(--gray-light), 60%);
				border-radius: 4px;
			}
			.format[data-format-badge='Conference'] {
				color: #1e40af;
				background: #dbeafe;
			}
			.format[data-format-badge='Community standup'] {
				color: #5b21b6;
				background: #ede9fe;
			}
			.format[data-format-badge='Live stream'] {
				color: #9f1239;
				background: #ffe4e6;
			}
			.format[data-format-badge='User group'] {
				color: #065f46;
				background: #d1fae5;
			}
			.format[data-format-badge='Podcast'] {
				color: #92400e;
				background: #fef3c7;
			}
			.format[data-format-badge='Workshop'] {
				color: #155e75;
				background: #cffafe;
			}
			.entry h4 {
				margin: 0;

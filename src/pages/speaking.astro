---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import gonedotnet from '../assets/gonedotnet.jpg';
import {
	FIRST_YEAR,
	FORMATS,
	RECORDED_TALKS,
	TOPICS,
	TOTAL_TALKS,
	talksByYear,
} from '../data/talks';

const title = 'Speaking';
const description =
	'Conference talks, community standups, user groups and live streams by Allan Ritchie — and how to book me for your event.';

const years = talksByYear();
const currentYear = new Date().getFullYear();
const yearsSpeaking = currentYear - Number(FIRST_YEAR) + 1;

const formatDate = (iso: string, monthOnly?: boolean) =>
	new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
		month: 'long',
		...(monthOnly ? {} : { day: 'numeric' }),
		year: 'numeric',
		timeZone: 'UTC',
	});
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head enter">
				<p class="eyebrow">Speaking</p>
				<h1 class="display">Talks &amp; <em>appearances</em></h1>
				<p class="lede">
					I've been talking about .NET, mobile and open source since {FIRST_YEAR} — on conference
					stages, community standups, user groups and a lot of live streams. If your event needs a
					speaker, I'd love to hear from you.
				</p>
				<dl class="stats">
					<div><dt>Talks</dt><dd>{TOTAL_TALKS}</dd></div>
					<div><dt>Years speaking</dt><dd>{yearsSpeaking}</dd></div>
					<div><dt>Recorded</dt><dd>{RECORDED_TALKS}</dd></div>
				</dl>
			</header>

			<section class="invite" aria-labelledby="invite-title" data-reveal-group>
				<div class="invite-copy" data-reveal>
					<h2 id="invite-title">Have me speak at <em>your</em> event</h2>
					<p>
						User group, conference, podcast or company lunch-and-learn — I'm happy to travel or dial
						in. I talk about my open source work, .NET in general, and 25 years of shipping software
						the hard way.
					</p>
					<ul class="topics" role="list">
						{TOPICS.map((topic) => <li>{topic}</li>)}
					</ul>
					<div class="invite-actions">
						<a class="btn btn--primary" href="mailto:allan@shinysoft.biz?subject=Speaking%20enquiry">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<rect
									x="3"
									y="5"
									width="18"
									height="14"
									rx="2"
									fill="none"
									stroke="currentColor"
									stroke-width="2"></rect>
								<path
									d="m3.5 7 8.5 6 8.5-6"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							<span>Get in touch</span>
						</a>
						<a
							class="btn btn--secondary"
							href="https://github.com/aritchie/talks"
							target="_blank"
							rel="noopener noreferrer"
						>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
									fill="currentColor"></path>
							</svg>
							<span>Slides &amp; samples</span>
						</a>
					</div>
				</div>

				<aside class="show surface-card spotlight" aria-labelledby="show-title" data-reveal>
					<a class="show-media" href="https://www.youtube.com/@GoneDotNet" target="_blank" rel="noopener noreferrer">
						<Image src={gonedotnet} alt="Gone .NET" width={640} densities={[1, 2]} />
					</a>
					<div class="show-copy">
						<p class="show-flag">Weekly · live</p>
						<h2 id="show-title">Gone .NET</h2>
						<p>
							Every week I go beyond the basics with my good friend <a
								href="https://x.com/redth"
								target="_blank"
								rel="noopener noreferrer">Jonathan Dick</a
							> — building real .NET samples and digging through the ecosystem live.
						</p>
						<div class="show-links">
							<a
								class="btn btn--primary"
								href="https://www.youtube.com/@GoneDotNet"
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path
										d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8M10 15V9l5.2 3Z"
										fill="currentColor"></path>
								</svg>
								<span>Watch on YouTube</span>
							</a>
							<a
								class="btn btn--secondary"
								href="https://www.gonedotnet.io"
								target="_blank"
								rel="noopener noreferrer"><span>www.gonedotnet.io</span></a
							>
						</div>
					</div>
				</aside>
			</section>

			<section class="archive" aria-labelledby="archive-title">
				<header class="archive-head" data-reveal>
					<div class="archive-heading">
						<h2 id="archive-title">Past <em>talks</em></h2>
						<span class="archive-count" data-count aria-live="polite">{TOTAL_TALKS} talks</span>
					</div>
					<div class="filters" role="group" aria-label="Filter by format">
						{
							FORMATS.map((format) => (
								<button type="button" class="chip" data-format={format} aria-pressed="false">
									{format}
								</button>
							))
						}
						<button type="button" class="chip chip--clear" data-clear hidden>Clear</button>
					</div>
				</header>

				<p class="empty-state" data-empty hidden>Nothing in that format yet.</p>

				{
					years.map(({ year, items }) => (
						<section class="year" data-year aria-label={`Talks from ${year}`}>
							<h3 class="year-marker" data-reveal>{year}</h3>
							<ol class="timeline" role="list">
								{items.map((talk) => (
									<li
										data-reveal
										class="entry"
										data-talk
										data-format={talk.format}
									>
										<article>
											<div class="entry-meta">
												<time datetime={talk.date}>{formatDate(talk.date, talk.monthOnly)}</time>
												<span class="format" data-format-badge={talk.format}>
													{talk.format}
												</span>
											</div>
											<h4>{talk.title ?? talk.event}</h4>
											{talk.title && <p class="entry-event">{talk.event}</p>}
											{talk.links && (
												<div class="entry-links">
													{talk.links.map((link) => (
														<a href={link.href} target="_blank" rel="noopener noreferrer">
															<span>{link.label}</span>
															<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
																<path
																	d="M7 17 17 7M9 7h8v8"
																	fill="none"
																	stroke="currentColor"
																	stroke-width="2"
																	stroke-linecap="round"
																	stroke-linejoin="round"
																/>
															</svg>
															<span class="sr-only">
																{talk.title ?? talk.event} on {link.label}
															</span>
														</a>
													))}
												</div>
											)}
										</article>
									</li>
								))}
							</ol>
						</section>
					))
				}
			</section>
		</main>
		<Footer />

		<script>
			const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-format]'))
				.filter((el): el is HTMLButtonElement => el.tagName === 'BUTTON');
			const clear = document.querySelector<HTMLButtonElement>('[data-clear]');
			const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-talk]'));
			const yearBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-year]'));
			const countEl = document.querySelector<HTMLElement>('[data-count]');
			const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
			const total = entries.length;

			const active = new Set<string>();

			function apply() {
				let visible = 0;
				for (const entry of entries) {
					// no selection means everything, otherwise OR across the chosen formats
					const show = active.size === 0 || active.has(entry.dataset.format ?? '');
					entry.hidden = !show;
					if (show) visible++;
				}
				for (const block of yearBlocks) {
					block.hidden = block.querySelectorAll('[data-talk]:not([hidden])').length === 0;
				}
				if (countEl) {
					countEl.textContent =
						active.size === 0
							? `${total} talks`
							: `${visible} of ${total} talk${total === 1 ? '' : 's'}`;
				}
				if (emptyEl) emptyEl.hidden = visible !== 0;
				if (clear) clear.hidden = active.size === 0;
			}

			for (const chip of chips) {
				chip.addEventListener('click', () => {
					const format = chip.dataset.format!;
					const next = !active.has(format);
					if (next) active.add(format);
					else active.delete(format);
					chip.setAttribute('aria-pressed', String(next));
					apply();
				});
			}

			clear?.addEventListener('click', () => {
				active.clear();
				for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
				apply();
			});

			apply();
		</script>

		<style>
			main {
				width: min(1120px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0;
			}

			/* ---------- invite + show ---------- */

			.invite {
				display: grid;
				gap: 1.5rem;
			}
			@media (min-width: 900px) {
				.invite {
					grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
					align-items: stretch;
				}
			}

			.invite-copy {
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: clamp(1.75rem, 4vw, 2.75rem);
				overflow: hidden;
				isolation: isolate;
				color: #f4f2fc;
				background: #0e0c1a;
				border-radius: calc(var(--radius-lg) + 8px);
				box-shadow: var(--box-shadow);
			}
			.invite-copy::before {
				content: '';
				position: absolute;
				inset: -50%;
				z-index: -1;
				background: conic-gradient(from 0deg, #5b3df5, #b23fd6, #f0613b, #f08a24, #5b3df5);
				filter: blur(90px);
				opacity: 0.45;
				animation: spin 20s linear infinite;
			}
			.invite-copy::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background: radial-gradient(90% 90% at 100% 100%, rgba(14, 12, 26, 0.1), rgba(14, 12, 26, 0.8));
			}
			@keyframes spin {
				to {
					rotate: 360deg;
				}
			}
			.invite-copy h2 {
				margin: 0 0 0.8rem;
				font-family: var(--font-display);
				font-weight: 400;
				font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem);
				line-height: 1;
				color: #fff;
			}
			.invite-copy h2 em {
				font-style: italic;
				color: #ffb074;
			}
			.invite-copy p {
				max-width: 46ch;
				margin: 0;
				font-size: 0.98rem;
				line-height: 1.6;
				color: rgba(244, 242, 252, 0.8);
				text-wrap: pretty;
			}
			.topics {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 1.4rem 0 0;
				padding: 0;
			}
			.topics li {
				list-style: none;
				padding: 0.32rem 0.7rem;
				font-size: 0.76rem;
				line-height: 1.3;
				color: rgba(244, 242, 252, 0.92);
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.16);
				border-radius: 999px;
			}
			.invite-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1.8rem;
			}
			.invite-copy .btn--primary {
				background: #fff;
				border-color: #fff;
				color: #0e0c1a;
			}
			.invite-copy .btn--primary:hover {
				color: #0e0c1a;
			}
			.invite-copy .btn--secondary {
				background: rgba(255, 255, 255, 0.06);
				border-color: rgba(255, 255, 255, 0.28);
				color: #fff;
			}
			.invite-copy .btn--secondary:hover {
				background: rgba(255, 255, 255, 0.14);
				border-color: #fff;
				color: #fff;
			}

			.show {
				display: flex;
				flex-direction: column;
				padding: 8px;
			}
			.show-media {
				display: block;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: rgba(var(--gray-light), 50%);
				border-radius: calc(var(--radius-lg) - 8px);
			}
			.show-media :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				margin: 0;
				transition: transform 0.9s var(--ease-out);
			}
			@media (hover: hover) and (pointer: fine) {
				.show:hover .show-media :global(img) {
					transform: scale(1.05);
				}
			}
			.show-copy {
				display: flex;
				flex: 1;
				flex-direction: column;
				gap: 0.55rem;
				padding: 1.25rem 1rem 1rem;
			}
			.show-flag {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			/* a live dot */
			.show-flag::before {
				content: '';
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #ef4444;
				box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6);
				animation: live 1.8s ease-out infinite;
			}
			@keyframes live {
				to {
					box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
				}
			}
			.show-copy h2 {
				margin: 0;
				font-family: var(--font-display);
				font-weight: 400;
				font-size: 2.2rem;
				line-height: 1;
			}
			.show-copy p {
				margin: 0;
				font-size: 0.93rem;
				line-height: 1.6;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}
			.show-links {
				position: relative;
				z-index: 1;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: auto;
				padding-top: 1rem;
			}

			/* ---------- archive ---------- */

			.archive {
				margin-top: clamp(4rem, 8vw, 6.5rem);
			}
			.archive-head {
				display: grid;
				gap: 1.25rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--border);
			}
			.archive-heading {
				display: flex;
				align-items: baseline;
				gap: 1rem;
			}
			.archive-heading h2 {
				margin: 0;
				font-family: var(--font-display);
				font-weight: 400;
				font-size: clamp(2.2rem, 1.6rem + 2.2vw, 3.4rem);
				line-height: 1;
			}
			.archive-heading h2 em {
				font-style: italic;
				color: var(--accent);
			}
			.archive-count {
				flex: 0 0 auto;
				padding: 0.3rem 0.65rem;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				border: 1px solid var(--border);
				border-radius: 999px;
			}
			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.empty-state {
				margin: 3rem 0;
				text-align: center;
				color: rgb(var(--gray));
			}

			/* ---------- timeline ---------- */

			.year {
				display: grid;
				gap: 0.75rem 2.5rem;
				padding-top: 2.75rem;
			}
			/* `display: grid` outranks the UA's [hidden] rule, so say it explicitly */
			.year[hidden] {
				display: none;
			}
			@media (min-width: 820px) {
				.year {
					grid-template-columns: 8rem minmax(0, 1fr);
				}
				.year-marker {
					position: sticky;
					top: 110px;
					align-self: start;
					text-align: right;
				}
			}
			.year-marker {
				margin: 0;
				font-family: var(--font-display);
				font-size: 3rem;
				font-weight: 400;
				line-height: 0.9;
				color: transparent;
				background: linear-gradient(180deg, rgb(var(--black)), rgba(var(--black), 0.25));
				-webkit-background-clip: text;
				background-clip: text;
			}

			.timeline {
				position: relative;
				margin: 0;
				padding: 0 0 0 1.75rem;
				list-style: none;
			}
			/* the rail fades in and out at its ends */
			.timeline::before {
				content: '';
				position: absolute;
				top: 0.4rem;
				bottom: 0;
				left: 0;
				width: 1px;
				background: linear-gradient(180deg, var(--accent), rgb(var(--gray-light)) 30%, rgb(var(--gray-light)) 85%, transparent);
			}
			.entry {
				position: relative;
				padding: 0 0 1.75rem;
			}
			.entry:last-child {
				padding-bottom: 0;
			}
			/* the dot on the rail */
			.entry::before {
				content: '';
				position: absolute;
				top: 0.5rem;
				left: calc(-1.75rem - 5px);
				width: 11px;
				height: 11px;
				background: var(--page-bg);
				border: 2px solid rgb(var(--gray-light));
				border-radius: 50%;
				transition:
					border-color 0.3s ease,
					background-color 0.3s ease,
					transform 0.4s var(--ease-spring),
					box-shadow 0.3s ease;
			}
			@media (hover: hover) and (pointer: fine) {
				.entry:hover::before {
					border-color: var(--accent);
					background: var(--accent);
					transform: scale(1.3);
					box-shadow: 0 0 0 5px var(--accent-soft);
				}
			}
			.entry article {
				padding: 0.1rem 0;
				transition: transform 0.4s var(--ease-out);
			}
			.entry:hover article {
				transform: translateX(4px);
			}
			.entry-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.3rem;
			}
			.entry-meta time {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: rgb(var(--gray));
			}
			.format {
				--tone: var(--accent);
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.18rem 0.55rem;
				font-size: 0.66rem;
				font-weight: 560;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: color-mix(in srgb, var(--tone) 80%, rgb(var(--black)));
				background: color-mix(in srgb, var(--tone) 12%, transparent);
				border: 1px solid color-mix(in srgb, var(--tone) 25%, transparent);
				border-radius: 999px;
			}
			.format::before {
				content: '';
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--tone);
			}
			.format[data-format-badge='Conference'] {
				--tone: #5b6cf5;
			}
			.format[data-format-badge='Community standup'] {
				--tone: #9b51e0;
			}
			.format[data-format-badge='Live stream'] {
				--tone: #e0457b;
			}
			.format[data-format-badge='User group'] {
				--tone: #10a37f;
			}
			.format[data-format-badge='Podcast'] {
				--tone: #e08a1e;
			}
			.format[data-format-badge='Workshop'] {
				--tone: #0ea5b7;
			}
			.entry h4 {
				margin: 0;
				font-size: 1.12rem;
				font-weight: 600;
				line-height: 1.35;
				color: rgb(var(--black));
				letter-spacing: -0.015em;
				text-wrap: pretty;
			}
			.entry-event {
				margin: 0.2rem 0 0;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.entry-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.6rem;
			}

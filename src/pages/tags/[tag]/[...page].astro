---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts } from '../../../utils/posts';
import { getReadingTime } from '../../../utils/readingTime';

export const getStaticPaths = (async ({ paginate }) => {
	// Astro hoists getStaticPaths into its own scope, so this can't live outside it
	const PAGE_SIZE = 12;
	const posts = await getPublishedPosts();

	const tags = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) tags.add(tag);
	}

	return [...tags].flatMap((tag) => {
		const tagged = posts.filter((p) => p.data.tags?.includes(tag));
		const minutes = new Map(tagged.map((p) => [p.id, getReadingTime(p.body).minutes]));
		return paginate(tagged, {
			params: { tag },
			pageSize: PAGE_SIZE,
			props: { tag, minutes, total: tagged.length },
		});
	});
}) satisfies GetStaticPaths;

type Props = {
	page: Page<CollectionEntry<'blog'>>;
	tag: string;
	minutes: Map<string, number>;
	total: number;
};

const { page, tag, minutes, total } = Astro.props;

const description = `Posts tagged "${tag}" by Allan Ritchie.`;
const title = page.currentPage === 1 ? tag : `${tag} — page ${page.currentPage}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
	</head>
	<body>
		<Header />
		<main>
			<header class="tag-head">
				<a class="back" href="/">
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path
							d="m14 6-6 6 6 6"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					<span>All posts</span>
				</a>
				<p class="eyebrow">Tagged</p>
				<h1>{tag}</h1>
				<p class="lede">
					{total} post{total === 1 ? '' : 's'}
					{page.lastPage > 1 && <> · page {page.currentPage} of {page.lastPage}</>}
				</p>
			</header>

			<ul class="grid" role="list">
				{
					page.data.map((post, i) => (
						<li>
							<PostCard post={post} minutes={minutes.get(post.id)} eager={i < 3} />
						</li>
					))
				}
			</ul>

			<Pagination page={page} label={`Posts tagged ${tag}`} />
		</main>
		<Footer />

		<style>
			main {
				width: min(1160px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0 0 5rem;
			}

			.tag-head {
				padding: 2.5rem 0 2rem;
			}
			.back {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				margin-bottom: 1.25rem;
				font-size: 0.82rem;
				font-weight: 700;
				text-decoration: none;
				color: rgb(var(--gray));
			}
			.back:hover {
				color: var(--accent);
			}
			.back svg {
				width: 1rem;
				height: 1rem;
			}
			.eyebrow {
				margin: 0 0 0.4rem;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.tag-head h1 {
				margin: 0 0 0.4rem;
				font-size: clamp(2.2rem, 1.7rem + 2.4vw, 3.4rem);
				letter-spacing: -0.03em;
				text-wrap: balance;
			}
			.lede {
				margin: 0;
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}

			.grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 1.25rem;
				margin: 0;
				padding: 0;
			}
			.grid li {
				min-width: 0;
				list-style: none;
			}
			@media (min-width: 640px) {
				.grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (min-width: 1000px) {
				.grid {
					grid-template-columns: repeat(3, minmax(0, 1fr));
				}
			}
		</style>
	</body>
</html>

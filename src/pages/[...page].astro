---
import type { GetStaticPaths, Page } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Pagination from '../components/Pagination.astro';
import PostCard from '../components/PostCard.astro';
import TagCloud from '../components/TagCloud.astro';
import me from '../assets/me.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';
import { getReadingTime } from '../utils/readingTime';

export const getStaticPaths = (async ({ paginate }) => {
	// Astro hoists getStaticPaths into its own scope, so this can't live outside it
	const PAGE_SIZE = 12;
	const posts = await getPublishedPosts();

	// Reading time comes from the raw body, which isn't available in the template
	const minutes = new Map(posts.map((p) => [p.id, getReadingTime(p.body).minutes]));

	const tagCounts = new Map<string, number>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
		}
	}

	return paginate(posts, {
		pageSize: PAGE_SIZE,
		props: { minutes, tagCounts, total: posts.length },
	});
}) satisfies GetStaticPaths;

type Props = {
	page: Page<CollectionEntry<'blog'>>;
	minutes: Map<string, number>;
	tagCounts: Map<string, number>;
	total: number;
};

const { page, minutes, tagCounts, total } = Astro.props;

const isFirstPage = page.currentPage === 1;
// The newest post gets the wide treatment; the rest fill the grid
const featured = isFirstPage ? page.data[0] : undefined;
const rest = isFirstPage ? page.data.slice(1) : page.data;

// BaseHead prefixes the site title, so pass only the distinguishing part
const title = isFirstPage ? SITE_TITLE : `Page ${page.currentPage}`;
const description = isFirstPage
	? SITE_DESCRIPTION
	: `Page ${page.currentPage} of posts by Allan Ritchie.`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
	</head>
	<body>
		<Header />
		<main>
			{
				isFirstPage ? (
					<section class="intro">
						<div class="intro-copy enter">
							<p class="eyebrow">Allan Ritchie · Toronto</p>
							<h1 class="display">
								Ramblings of an <em>old</em> software engineer
							</h1>
							<p class="lede">
								Notes from 25 years of shipping software — .NET, mobile, and the open source
								libraries I maintain when I should probably be sleeping.
							</p>
							<div class="intro-actions">
								<a class="btn btn--primary" href="/about/">
									<span>About me</span>
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path
											d="M5 12h14M13 6l6 6-6 6"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</a>
								<a class="btn btn--secondary" href="/projects/"><span>Projects</span></a>
								<a class="btn btn--secondary" href="/speaking/"><span>Speaking</span></a>
								<a class="btn btn--secondary" href="mailto:allan@shinysoft.biz">
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<rect
											x="3"
											y="5"
											width="18"
											height="14"
											rx="2"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
										/>
										<path
											d="m3.5 7 8.5 6 8.5-6"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									<span>Get in touch</span>
								</a>
								<a class="btn btn--ghost" href="/rss.xml">
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<circle cx="6.2" cy="17.8" r="2.2" fill="currentColor" />
										<path
											d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5M4 4a16 16 0 0 1 16 16"
											fill="none"
											stroke="currentColor"
											stroke-width="2.4"
											stroke-linecap="round"
										/>
									</svg>
									<span>RSS</span>
								</a>
							</div>
						</div>

						<div class="orbit" aria-hidden="true">
							<span class="orbit-ring orbit-ring--outer"></span>
							<span class="orbit-ring orbit-ring--inner"></span>
							<div class="intro-avatar">
								<Image src={me} alt="" width={360} densities={[1, 2]} loading="eager" />
							</div>
							<span class="orbit-chip orbit-chip--a">.NET</span>
							<span class="orbit-chip orbit-chip--b">MAUI</span>
							<span class="orbit-chip orbit-chip--c">Open source</span>
							<span class="orbit-chip orbit-chip--d">{total} posts</span>
						</div>
					</section>
				) : (
					<header class="page-head enter">
						<p class="eyebrow">Archive</p>
						<h1 class="display">
							Page {page.currentPage} <em>of {page.lastPage}</em>
						</h1>
						<p class="lede">Older posts, newest first.</p>
					</header>
				)
			}

			<section class="listing" aria-label={isFirstPage ? 'Latest posts' : 'Posts'}>
				<div class="listing-head" data-reveal>
					<h2 class="section-title">{isFirstPage ? <>Latest <em>writing</em></> : 'Posts'}</h2>
					<span class="listing-count">
						{page.start + 1}–{page.end + 1} of {total}
					</span>
				</div>

				{
					featured && (
						<div class="featured">
							<PostCard post={featured} minutes={minutes.get(featured.id)} variant="featured" eager />
						</div>
					)
				}

				<ul class="grid" role="list" data-reveal-group>
					{
						rest.map((post, i) => (
							<li>
								<PostCard post={post} minutes={minutes.get(post.id)} eager={!isFirstPage && i < 3} />
							</li>
						))
					}
				</ul>

				<Pagination page={page} />
			</section>

			{
				isFirstPage && (
					<section class="topics" aria-labelledby="topics-title" data-reveal>
						<p class="eyebrow">Topics</p>
						<h2 id="topics-title" class="section-title">
							Browse by <em>topic</em>
						</h2>
						<TagCloud tags={tagCounts} />
					</section>
				)
			}
		</main>
		<Footer />

		<style>
			main {
				width: min(1200px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0;
			}

			/* ---------- intro ---------- */

			.intro {
				display: grid;
				gap: 2.5rem;
				align-items: center;
				padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
			}
			@media (min-width: 900px) {
				.intro {
					grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
					gap: 3rem;
				}
			}
			.intro .display {
				max-width: 12ch;
			}
			.intro-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 2rem;
			}

			/* ---------- portrait in orbit ---------- */

			.orbit {
				position: relative;
				display: grid;
				place-items: center;
				width: min(100%, 440px);
				aspect-ratio: 1;
				margin: 0 auto;
				animation: enter 1.2s var(--ease-out) 0.2s both;
			}
			.orbit-ring {
				position: absolute;
				border-radius: 50%;
				border: 1px dashed var(--border-strong);
			}
			.orbit-ring--outer {
				inset: 0;
				animation: spin 60s linear infinite;
			}
			.orbit-ring--inner {
				inset: 12%;
				border-style: solid;
				border-color: var(--border);
				animation: spin 40s linear infinite reverse;
			}
			/* a bead of light travelling round each ring */
			.orbit-ring::after {
				content: '';
				position: absolute;
				top: 50%;
				left: -4px;
				width: 8px;
				height: 8px;
				margin-top: -4px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 14px 2px color-mix(in srgb, var(--accent) 70%, transparent);
			}
			.orbit-ring--inner::after {
				left: auto;
				right: -3px;
				width: 6px;
				height: 6px;
				background: var(--accent-3);
				box-shadow: 0 0 14px 2px color-mix(in srgb, var(--accent-3) 70%, transparent);
			}
			@keyframes spin {
				to {
					rotate: 360deg;
				}
			}

			.intro-avatar {
				position: relative;
				width: 62%;
				aspect-ratio: 1;
				padding: 5px;
				border-radius: 50%;
				background: conic-gradient(
					from var(--ring-angle),
					var(--accent),
					var(--accent-2),
					var(--accent-3),
					var(--accent)
				);
				animation: ring-spin 6s linear infinite;
				box-shadow: 0 30px 80px -20px color-mix(in srgb, var(--accent) 55%, transparent);
			}
			@property --ring-angle {
				syntax: '<angle>';
				inherits: false;
				initial-value: 0deg;
			}
			@keyframes ring-spin {
				to {
					--ring-angle: 360deg;
				}
			}
			.intro-avatar :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 18%;
				margin: 0;
				border-radius: 50%;
				/* the portrait is a cut-out on white, so its plate stays light in both themes */
				background: radial-gradient(circle at 50% 20%, #ffffff, #e9e5f5);
				border: 4px solid var(--page-bg);
			}

			.orbit-chip {
				position: absolute;
				padding: 0.45rem 0.85rem;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 500;
				white-space: nowrap;
				color: rgb(var(--black));
				background: var(--glass);
				-webkit-backdrop-filter: blur(14px);
				backdrop-filter: blur(14px);
				border: 1px solid var(--border-strong);
				border-radius: 999px;
				box-shadow: var(--card-shadow);
				animation: float 6s ease-in-out infinite;
			}
			.orbit-chip::before {
				content: '';
				display: inline-block;
				width: 6px;
				height: 6px;
				margin-right: 0.45rem;
				border-radius: 50%;
				vertical-align: 1px;
				background: var(--accent);
			}
			.orbit-chip--a {
				top: 12%;
				left: 2%;
			}
			.orbit-chip--b {
				top: 20%;
				right: 0;
				animation-delay: -1.5s;
			}
			.orbit-chip--b::before {
				background: var(--accent-2);
			}
			.orbit-chip--c {
				bottom: 16%;
				left: -2%;
				animation-delay: -3s;
			}
			.orbit-chip--c::before {
				background: var(--accent-3);
			}
			.orbit-chip--d {
				bottom: 8%;
				right: 8%;
				animation-delay: -4.5s;
			}
			.orbit-chip--d::before {
				background: #34d399;
			}
			@keyframes float {
				50% {
					translate: 0 -10px;
				}
			}
			@media (max-width: 899px) {
				.orbit {
					width: min(100%, 340px);
					order: -1;
				}
			}

			/* ---------- listing ---------- */

			.listing-head {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.listing-head .section-title {
				margin: 0;
			}
			.listing-count {
				flex: 0 0 auto;
				padding: 0.4rem 0.8rem;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				border: 1px solid var(--border);
				border-radius: 999px;
			}

			.featured {
				margin-bottom: 1.5rem;
			}
			.grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 1.5rem;
				margin: 0;
				padding: 0;
			}
			.grid li {
				min-width: 0;
				list-style: none;
			}
			@media (min-width: 640px) {
				.grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (min-width: 1000px) {
				.grid {
					grid-template-columns: repeat(3, minmax(0, 1fr));
				}
			}

			/* ---------- topics ---------- */

			.topics {
				margin-top: clamp(4rem, 8vw, 7rem);
				text-align: center;
			}
			.topics .section-title {
				margin-bottom: 1.75rem;
			}
		</style>
	</body>
</html>

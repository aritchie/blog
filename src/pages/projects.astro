---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GROUPS, TAGS, TOTAL_PROJECTS, githubUrl } from '../data/projects';

const title = 'Projects';
const description =
	'Open source .NET frameworks, libraries, developer tooling and sample apps by Allan Ritchie.';

// Resolve hero artwork to URLs rather than importing the SVGs as components -
// several of them share element ids (`bg`, `grid`, `glow`), which would collide
// if they were inlined together on one page.
const heroUrls = import.meta.glob<string>(['../assets/*.svg', '../assets/projects/*.svg'], {
	query: '?url',
	import: 'default',
	eager: true,
});
const heroUrl = (file?: string) => (file ? heroUrls[`../assets/${file}`] : undefined);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<p class="eyebrow">Open source</p>
				<h1>Projects</h1>
				<p class="lede">
					Frameworks, libraries, developer tooling and sample apps — built in the open, maintained
					in public, and shipped to production by teams I'll never meet.
				</p>
				<dl class="stats">
					<div><dt>Projects</dt><dd>{TOTAL_PROJECTS}</dd></div>
					<div><dt>NuGet downloads</dt><dd>40M+</dd></div>
					<div><dt>Years maintaining</dt><dd>15</dd></div>
				</dl>
			</header>

			<div class="toolbar" data-toolbar>
				<div class="search">
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
						<path d="m16.5 16.5 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
					<input
						type="search"
						id="project-search"
						placeholder="Search projects…"
						autocomplete="off"
						data-search
					/>
					<label class="sr-only" for="project-search">Search projects</label>
				</div>
				<div class="tag-filters" role="group" aria-label="Filter by technology">
					{
						TAGS.map((tag) => (
							<button type="button" class="tag-filter" data-tag={tag} aria-pressed="false">
								{tag}
							</button>
						))
					}
					<button type="button" class="tag-filter tag-clear" data-clear data-clear-toggle hidden>
						Clear
					</button>
				</div>
				<p class="result-count" data-count aria-live="polite">
					Showing all {TOTAL_PROJECTS} projects
				</p>
			</div>

			<span class="results-top" data-results-top aria-hidden="true"></span>

			<p class="empty-state" data-empty hidden>
				No projects match that. <button type="button" data-clear>Clear the filters</button> and start
				over.
			</p>

			{
				GROUPS.map((group) => (
					<section class="group" id={group.id} data-group aria-labelledby={`${group.id}-title`}>
						<header class="group-head">
							<div class="group-heading">
								<h2 id={`${group.id}-title`}>{group.title}</h2>
								<span class="group-count" data-group-count>
									{group.projects.length} projects
								</span>
							</div>
							<p>{group.blurb}</p>
						</header>

						<ul class:list={['grid', `grid--${group.layout}`]} role="list">
							{group.projects.map((project, i) => (
								<li
									class:list={['cell', group.layout === 'media' && i === 0 && 'cell--lead']}
									data-project
									data-tags={project.tags.join('|')}
									data-text={`${project.name} ${project.repo} ${project.tagline} ${(
										project.highlights ?? []
									).join(' ')} ${project.tags.join(' ')}`.toLowerCase()}
								>
									<article class:list={['card', `card--${group.layout}`]}>
										{project.hero && (
											<div class="card-media">
												<img
													src={heroUrl(project.hero)}
													alt=""
													width="1200"
													height="630"
													loading={group.id === GROUPS[0].id && i === 0 ? 'eager' : 'lazy'}
													decoding="async"
												/>
											</div>
										)}
										<div class="card-body">
											<span class="repo">
												<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
													<path
														d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
														fill="currentColor"
													/>
												</svg>
												{project.repo}
											</span>
											<h3>{project.name}</h3>
											<p class="tagline">{project.tagline}</p>
											{project.highlights && (
												<ul class="highlights" role="list">
													{project.highlights.map((h) => (
														<li>{h}</li>
													))}
												</ul>
											)}
											<div class="actions">
												{project.docs && (
													<a
														class="btn btn--primary"
														href={project.docs}
														target="_blank"
														rel="noopener noreferrer"
													>
														<span>Documentation</span>
														<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
															<path
																d="M7 17 17 7M9 7h8v8"
																fill="none"
																stroke="currentColor"
																stroke-width="2"
																stroke-linecap="round"
																stroke-linejoin="round"
															/>
														</svg>
														<span class="sr-only">for {project.name}</span>
													</a>
												)}
												<a
													class:list={['btn', project.docs ? 'btn--secondary' : 'btn--primary']}
													href={githubUrl(project.repo)}
													target="_blank"
													rel="noopener noreferrer"
												>
													<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
														<path
															d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
															fill="currentColor"
														/>
													</svg>
													<span>Source</span>
													<span class="sr-only">for {project.name} on GitHub</span>
												</a>
											</div>
										</div>
									</article>
								</li>
							))}
						</ul>
					</section>
				))
			}

			<section class="coda" aria-labelledby="coda-title">
				<div class="coda-copy">
					<h2 id="coda-title">Support my work</h2>
					<p>
						All of this is free, and all of it is maintained on evenings and weekends. If it saves
						your team time, there are a few ways to give some back — help write documentation and
						samples, take on an issue tagged <em>help wanted</em>, file defects with a complete
						repro, or sponsor the work directly.
					</p>
					<div class="coda-links">
						<a class="btn btn--primary" href="https://github.com/sponsors/aritchie" target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="M12 20.5S3.5 15 3.5 9.2A4.7 4.7 0 0 1 12 6.4a4.7 4.7 0 0 1 8.5 2.8c0 5.8-8.5 11.3-8.5 11.3Z"
									fill="currentColor"
								/>
							</svg>
							<span>Become a sponsor</span>
						</a>
						<a class="btn btn--secondary" href="https://nuget.org/profiles/aritchie" target="_blank" rel="noopener noreferrer">
							<span>NuGet · aritchie</span>
						</a>
						<a class="btn btn--secondary" href="https://nuget.org/profiles/ShinyLib" target="_blank" rel="noopener noreferrer">
							<span>NuGet · ShinyLib</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const search = document.querySelector<HTMLInputElement>('[data-search]');
			const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag]'));
			const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-clear]'));
			const cells = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
			const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
			const countEl = document.querySelector<HTMLElement>('[data-count]');
			const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
			const clearToggle = document.querySelector<HTMLElement>('[data-clear-toggle]');
			const resultsTop = document.querySelector<HTMLElement>('[data-results-top]');
			const total = cells.length;

			const activeTags = new Set<string>();

			/**
			 * Filtering can shrink the page out from under the reader and leave them
			 * parked on the footer. If the results have scrolled off the top, pull the
			 * top of the list back into view - once, since after that it's on screen.
			 */
			function keepResultsInView() {
				if (!resultsTop) return;
				const top = resultsTop.getBoundingClientRect().top;
				if (top >= 0) return;
				window.scrollTo({ top: window.scrollY + top - 90, behavior: 'smooth' });
			}

			function apply() {
				const query = (search?.value ?? '').trim().toLowerCase();
				let visible = 0;

				for (const cell of cells) {
					const text = cell.dataset.text ?? '';
					const tags = (cell.dataset.tags ?? '').split('|');
					const matchesText = query === '' || text.includes(query);
					// OR across tags - picking MAUI and Blazor should widen the net, not narrow it
					const matchesTags = activeTags.size === 0 || tags.some((t) => activeTags.has(t));
					const show = matchesText && matchesTags;
					cell.hidden = !show;
					if (show) visible++;
				}

				for (const group of groups) {
					const shown = group.querySelectorAll<HTMLElement>('[data-project]:not([hidden])').length;
					group.hidden = shown === 0;
					const badge = group.querySelector<HTMLElement>('[data-group-count]');
					if (badge) badge.textContent = `${shown} project${shown === 1 ? '' : 's'}`;
				}

				const filtering = query !== '' || activeTags.size > 0;
				if (countEl) {
					countEl.textContent = filtering
						? `${visible} of ${total} projects`
						: `Showing all ${total} projects`;
				}
				if (emptyEl) emptyEl.hidden = visible !== 0;
				if (clearToggle) clearToggle.hidden = !filtering;
			}

			search?.addEventListener('input', () => {
				apply();
				keepResultsInView();
			});

			for (const btn of tagButtons) {
				btn.addEventListener('click', () => {
					const tag = btn.dataset.tag!;
					const next = !activeTags.has(tag);
					if (next) activeTags.add(tag);
					else activeTags.delete(tag);
					btn.setAttribute('aria-pressed', String(next));
					apply();
					keepResultsInView();
				});
			}

			for (const btn of clearButtons) {
				btn.addEventListener('click', () => {
					activeTags.clear();
					for (const t of tagButtons) t.setAttribute('aria-pressed', 'false');
					if (search) search.value = '';
					apply();
					keepResultsInView();
					search?.focus();
				});
			}

			apply();
		</script>

		<style>
			main {
				width: min(1180px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0 0 5rem;
			}

			/* ---------- page head ---------- */

			.page-head {
				padding: 3.5rem 0 2.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.eyebrow {
				margin: 0 0 0.5rem;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.page-head h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(2.6rem, 1.9rem + 3vw, 4.2rem);
				letter-spacing: -0.03em;
			}
			.lede {
				max-width: 62ch;
				margin: 0;
				font-size: 1.05rem;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}
			.stats {
				display: flex;
				flex-wrap: wrap;
				gap: 2.5rem;
				margin: 2rem 0 0;
			}
			.stats dt {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.stats dd {
				margin: 0.15rem 0 0;
				font-size: 1.7rem;
				font-weight: 700;
				line-height: 1;
				color: rgb(var(--black));
			}

			/* ---------- toolbar ---------- */

			.toolbar {
				position: sticky;
				top: 60px;
				z-index: 20;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem 1rem;
				margin: 0 -0.75rem;
				padding: 0.9rem 0.75rem;
				background: var(--glass);
				backdrop-filter: blur(16px) saturate(180%);
				-webkit-backdrop-filter: blur(16px) saturate(180%);
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.search {
				position: relative;
				display: flex;
				align-items: center;
				flex: 0 1 260px;
			}
			.search svg {
				position: absolute;
				left: 0.7rem;
				width: 1rem;
				height: 1rem;
				color: rgb(var(--gray));
				pointer-events: none;
			}
			.search input {
				width: 100%;
				padding: 0.5rem 0.7rem 0.5rem 2.2rem;
				font-family: inherit;
				font-size: 0.9rem;
				color: rgb(var(--gray-dark));
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				transition: border-color 0.15s ease, box-shadow 0.15s ease;
			}
			.search input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px var(--accent-soft);
			}
			.tag-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.tag-filter {
				padding: 0.35rem 0.7rem;
				font-family: inherit;
				font-size: 0.78rem;
				font-weight: 700;
				line-height: 1;
				color: rgb(var(--gray-dark));
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.tag-filter:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.tag-filter[aria-pressed='true'] {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--on-accent);
			}
			.tag-clear {
				color: rgb(var(--gray));
				border-style: dashed;
			}
			.result-count {
				margin: 0 0 0 auto;
				font-size: 0.8rem;
				font-weight: 700;
				color: rgb(var(--gray));
				white-space: nowrap;
			}

			/* scroll anchor for the top of the results - see keepResultsInView() */
			.results-top {
				display: block;
				height: 0;
			}

			.empty-state {
				margin: 4rem 0;
				text-align: center;
				color: rgb(var(--gray));
			}
			.empty-state button {
				font: inherit;
				color: var(--accent);
				background: none;
				border: none;
				padding: 0;
				text-decoration: underline;
				cursor: pointer;
			}

			/* ---------- groups ---------- */

			.group {
				margin-top: clamp(3.5rem, 6vw, 5.5rem);
			}
			.group-head {
				display: grid;
				gap: 0.6rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.group-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
			}
			.group-heading h2 {
				margin: 0;
				font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.8rem);
				letter-spacing: -0.03em;
			}
			.group-count {
				flex: 0 0 auto;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.group-head p {
				max-width: 60ch;
				margin: 0;
				font-size: 0.95rem;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}

			/* ---------- grid ---------- */

			.grid {
				display: grid;
				gap: 1.25rem;
				margin: 1.5rem 0 0;
				padding: 0;
				grid-template-columns: minmax(0, 1fr);
			}
			.cell {
				min-width: 0;
				list-style: none;
			}
			@media (min-width: 640px) {
				.grid--media {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.grid--compact {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.cell--lead {
					grid-column: 1 / -1;
				}
			}
			@media (min-width: 1000px) {
				.grid--compact {
					grid-template-columns: repeat(3, minmax(0, 1fr));
				}
			}

			/* ---------- cards ---------- */

			.card {
				position: relative;
				display: flex;
				flex-direction: column;
				height: 100%;
				overflow: hidden;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				box-shadow: 0 1px 2px rgba(var(--shadow), 12%);
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}
			@media (hover: hover) and (pointer: fine) {
				.card:hover {
					transform: translateY(-3px);
					border-color: var(--accent);
					box-shadow: 0 10px 30px rgba(var(--shadow), 22%);
				}
			}
			.card-media {
				position: relative;
				aspect-ratio: 1200 / 630;
				overflow: hidden;
				background: #0f172a;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.card-media img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.card-body {
				display: flex;
				flex: 1;
				flex-direction: column;
				gap: 0.6rem;
				padding: 1.15rem 1.25rem 1.25rem;
			}
			.repo {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
				font-size: 0.72rem;
				color: rgb(var(--gray));
				overflow-wrap: anywhere;
			}
			.repo svg {
				flex: 0 0 auto;
				width: 0.85rem;
				height: 0.85rem;
			}
			.card-body h3 {
				margin: 0;
				font-size: 1.4rem;
				letter-spacing: -0.02em;
				line-height: 1.15;
				text-wrap: balance;
			}
			.card--compact .card-body h3 {
				font-size: 1.2rem;
			}
			.tagline {
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
				text-wrap: pretty;
			}
			.highlights {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin: 0.2rem 0 0;
				padding: 0;
			}
			.highlights li {
				list-style: none;
				padding: 0.25rem 0.55rem;
				font-size: 0.72rem;
				line-height: 1.3;
				color: rgb(var(--gray-dark));
				background: rgba(var(--gray-light), 55%);
				border-radius: 6px;
			}
			.card--compact .highlights li {
				font-size: 0.68rem;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: auto;
				padding-top: 0.85rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.5rem 0.85rem;
				font-size: 0.82rem;
				font-weight: 700;
				line-height: 1;
				text-decoration: none;
				border: 1px solid transparent;
				border-radius: 8px;
				transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
			}
			.btn svg {
				flex: 0 0 auto;
				width: 0.95rem;
				height: 0.95rem;
			}
			.btn--primary {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--on-accent);
			}
			.btn--primary:hover {
				background: var(--accent-dark);
				border-color: var(--accent-dark);
				color: var(--on-accent);
			}
			.btn--secondary {
				background: var(--surface);
				border-color: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.btn--secondary:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* lead card: art beside the copy once there's room for both */
			@media (min-width: 980px) {
				.cell--lead .card {
					display: grid;
					grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
				}
				.cell--lead .card-media {
					height: 100%;
					aspect-ratio: auto;
					border-right: 1px solid rgb(var(--gray-light));
					border-bottom: 0;
				}
				.cell--lead .card-body {
					padding: 1.75rem;
					gap: 0.7rem;
				}
				.cell--lead .card-body h3 {
					font-size: 2rem;
				}
				.cell--lead .tagline {
					font-size: 1rem;
				}
			}

			/* ---------- coda ---------- */

			.coda {
				margin-top: clamp(4rem, 7vw, 6rem);
				padding-top: clamp(2rem, 4vw, 3rem);
				border-top: 1px solid rgb(var(--gray-light));
			}
			.coda h2 {
				margin: 0 0 0.6rem;
				font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.8rem);
				letter-spacing: -0.03em;
			}
			.coda-copy p {
				max-width: 64ch;
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.coda-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1.5rem;
			}

			@media (max-width: 720px) {
				.toolbar {
					top: 56px;
					gap: 0.6rem;
				}
				.search {
					flex: 1 1 100%;
				}
				/* a sticky bar three rows deep eats the screen - pan the pills instead */
				.tag-filters {
					flex: 1 1 100%;
					flex-wrap: nowrap;
					overflow-x: auto;
					overscroll-behavior-x: contain;
					scrollbar-width: none;
					padding-bottom: 0.15rem;
				}
				.tag-filters::-webkit-scrollbar {
					display: none;
				}
				.tag-filter {
					flex: 0 0 auto;
				}
				.result-count {
					margin-left: 0;
				}
				.stats {
					gap: 1.5rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.card,
				.btn,
				.tag-filter {
					transition: none;
				}
				.card:hover {
					transform: none;
				}
			}
		</style>
	</body>
</html>

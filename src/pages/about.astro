				margin: 0 auto;
				line-height: 1.65;
				color: rgba(244, 242, 252, 0.8);
				text-wrap: pretty;
			}
			.contact-actions {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.6rem;

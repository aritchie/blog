			/* ---------- contact ---------- */

			.contact {
				position: relative;
				margin-top: clamp(4rem, 8vw, 6.5rem);
				padding: clamp(2.25rem, 6vw, 4.5rem);
				overflow: hidden;
				isolation: isolate;
				text-align: center;
				color: #f4f2fc;
				background: #0e0c1a;
				border-radius: calc(var(--radius-lg) + 8px);
				box-shadow: var(--box-shadow);
			}
			/* slow-turning colour behind the call to action */
			.contact::before {
				content: '';
				position: absolute;
				inset: -60%;
				z-index: -1;
				background: conic-gradient(
					from 0deg,
					#5b3df5,
					#b23fd6,
					#f0613b,
					#f08a24,
					#5b3df5
				);
				filter: blur(80px);
				opacity: 0.55;
				animation: spin 18s linear infinite;
			}
			.contact::after {
				content: '';
				position: absolute;
				inset: 1px;
				z-index: -1;
				border-radius: inherit;
				background: radial-gradient(80% 90% at 50% 120%, rgba(14, 12, 26, 0.2), rgba(14, 12, 26, 0.85));
			}
			@keyframes spin {
				to {
					rotate: 360deg;

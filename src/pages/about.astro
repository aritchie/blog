---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import gonedotnet from '../assets/gonedotnet.jpg';
import me from '../assets/me.jpg';
import mvp from '../assets/msft_mvp.png';
import shiny from '../assets/shiny.png';
import shinysoft from '../assets/shinysoft-logo.png';
import toronto from '../assets/toronto_pan.jpg';
import xammvp from '../assets/xammvp.png';
import { TOTAL_PROJECTS } from '../data/projects';

const title = 'About';
const description =
	'Allan Ritchie — software engineer, architect, consultant and open source maintainer. 25 years of shipping software, 40M+ NuGet downloads, Microsoft MVP since 2017.';

const recognition = [
	{
		image: mvp,
		alt: 'Microsoft Most Valuable Professional',
		label: 'Microsoft MVP',
		detail: 'Since 2017 — ten consecutive years',
		href: 'https://mvp.microsoft.com/en-US/mvp/profile/501ddb3a-4d15-e711-810b-3863bb36edf8',
	},
	{
		image: xammvp,
		alt: 'Xamarin MVP',
		label: 'Xamarin MVP',
		detail: 'Awarded for cross-platform mobile work',
	},
	{
		image: shiny,
		alt: 'Shiny',
		label: 'Shiny',
		detail: 'The libraries behind most of it',
		href: 'https://shinylib.net',
	},
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy enter">
					<p class="eyebrow">About</p>
					<h1 class="display">Hi, I'm <em>Allan</em> Ritchie</h1>
					<p class="lede">
						A software engineer, architect, consultant and open source maintainer, with experience
						spanning web, mobile, and everything in between — from startups to large enterprises.
					</p>
					<ul class="facts" role="list">
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linejoin="round"></path>
								<circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2"
								></circle>
							</svg>
							Toronto, Canada
						</li>
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="m12 3 2.6 5.6 6.4.8-4.7 4.3 1.3 6.3L12 17l-5.6 3 1.3-6.3L3 9.4l6.4-.8Z"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linejoin="round"></path>
							</svg>
							Microsoft MVP since 2017
						</li>
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									d="M4 7h16M4 12h16M4 17h10"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"></path>
							</svg>
							Founder, ShinySoft Technologies
						</li>
					</ul>
					<div class="hero-actions">
						<a class="btn btn--primary" href="mailto:allan@shinysoft.biz">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<rect
									x="3"
									y="5"
									width="18"
									height="14"
									rx="2"
									fill="none"
									stroke="currentColor"
									stroke-width="2"></rect>
								<path
									d="m3.5 7 8.5 6 8.5-6"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							<span>Get in touch</span>
						</a>
						<a class="btn btn--secondary" href="/projects"><span>See the projects</span></a>
					</div>
				</div>

				<div class="hero-portrait">
					<span class="portrait-glow" aria-hidden="true"></span>
					<Image src={me} alt="Allan Ritchie" width={720} densities={[1, 2]} loading="eager" />
				</div>
			</section>

			<dl class="stats" data-reveal-group>
				<div data-reveal><dt>Years shipping software</dt><dd>25</dd></div>
				<div data-reveal><dt>NuGet downloads</dt><dd>40M+</dd></div>
				<div data-reveal><dt>Open source projects</dt><dd>{TOTAL_PROJECTS}</dd></div>
				<div data-reveal><dt>Years as an MVP</dt><dd>10</dd></div>
			</dl>

			<section class="story" aria-labelledby="story-title" data-reveal>
				<div class="story-aside">
					<p class="eyebrow">Story</p>
					<h2 id="story-title" class="section-title">The <em>long</em> version</h2>
				</div>
				<div class="story-copy">
					<p>
						Over a 25-year career I've shipped software across industries including commercial real
						estate, healthcare, and logistics. Starting with Perl, PHP, Java, C++, and classic ASP,
						I've since worked across the full modern stack. For the past seven years I've run my own
						consultancy, <a href="https://shinysoft.biz" target="_blank" rel="noopener noreferrer"
							>ShinySoft Technologies</a
						>, helping companies deliver mobile apps, web applications, backend services, and cloud
						infrastructure.
					</p>
					<p>
						I'm also a dedicated open source contributor. Over the past 15 years I've authored and
						maintained numerous .NET libraries — beginning with contributions to NHibernate and other
						established projects before creating my own. Collectively, my libraries have surpassed 40
						million downloads.
					</p>
					<p>
						I'm passionate about sharing knowledge through <a href="/speaking">public speaking</a> and
						livestreaming. My contributions have been recognized with the Xamarin MVP award and, since
						2017, the <a
							href="https://mvp.microsoft.com/en-US/mvp/profile/501ddb3a-4d15-e711-810b-3863bb36edf8"
							target="_blank"
							rel="noopener noreferrer">Microsoft MVP</a
						> award — an honour I've held for ten consecutive years.
					</p>
				</div>
			</section>

			<section class="activity" aria-labelledby="activity-title" data-reveal>
				<p class="eyebrow">Activity</p>
				<h2 id="activity-title" class="section-title">Still <em>shipping</em></h2>
				<p class="section-lede">
					Most days end with a commit somewhere. Here's the last year on GitHub — every lit square
					is work on one of the <a href="/projects">projects</a>.
				</p>
				<ContributionGraph user="aritchie" />
			</section>

			<section class="skyline" aria-label="Toronto" data-reveal>
				<Image src={toronto} alt="" width={2458} densities={[1, 2]} loading="lazy" />
				<p><span>Built from</span> Toronto, Canada</p>
			</section>

			<section class="ventures" aria-labelledby="ventures-title">
				<p class="eyebrow" data-reveal>Now</p>
				<h2 id="ventures-title" class="section-title" data-reveal>What I'm doing <em>now</em></h2>
				<div class="venture-grid" data-reveal-group>
					<article class="venture surface-card spotlight" data-reveal>
						<a
							class="venture-media venture-media--pad"
							href="https://shinysoft.biz"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Image src={shinysoft} alt="ShinySoft Technologies" width={800} densities={[1, 2]} />
						</a>
						<div class="venture-copy">
							<p class="flag">Consultancy</p>
							<h3>ShinySoft Technologies</h3>
							<p>
								My consultancy. We build mobile apps, web applications, backend services, and the
								cloud infrastructure behind them — for startups and enterprises alike.
							</p>
							<div class="venture-links">
								<a
									class="btn btn--primary"
									href="https://shinysoft.biz"
									target="_blank"
									rel="noopener noreferrer"><span>shinysoft.biz</span></a
								>
							</div>
						</div>
					</article>

					<article class="venture surface-card spotlight" data-reveal>
						<a
							class="venture-media"
							href="https://www.youtube.com/@GoneDotNet"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Image src={gonedotnet} alt="Gone .NET" width={800} densities={[1, 2]} />
						</a>
						<div class="venture-copy">
							<p class="flag">Weekly livestream</p>
							<h3>Gone .NET</h3>
							<p>
								I co-host a weekly YouTube livestream with <a
									href="https://x.com/redth"
									target="_blank"
									rel="noopener noreferrer">Jonathan Dick</a
								>, where we go beyond the basics — building real-world .NET samples and exploring the
								ecosystem in depth.
							</p>
							<div class="venture-links">
								<a
									class="btn btn--primary"
									href="https://www.youtube.com/@GoneDotNet"
									target="_blank"
									rel="noopener noreferrer"
								>
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path
											d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8M10 15V9l5.2 3Z"
											fill="currentColor"></path>
									</svg>
									<span>YouTube</span>
								</a>
								<a
									class="btn btn--secondary"
									href="https://www.gonedotnet.io"
									target="_blank"
									rel="noopener noreferrer"><span>www.gonedotnet.io</span></a
								>
							</div>
						</div>
					</article>
				</div>
			</section>

			<section class="recognition" aria-labelledby="recognition-title">
				<p class="eyebrow" data-reveal>Recognition</p>
				<h2 id="recognition-title" class="section-title" data-reveal>Kind <em>words</em> from others</h2>
				<ul class="badge-grid" role="list" data-reveal-group>
					{
						recognition.map((item) => {
							const Tag = item.href ? 'a' : 'div';
							return (
								<li data-reveal>
									<Tag
										class="badge surface-card spotlight"
										href={item.href}
										target={item.href ? '_blank' : undefined}
										rel={item.href ? 'noopener noreferrer' : undefined}
									>
										<span class="badge-frame">
											<Image src={item.image} alt={item.alt} width={420} densities={[1, 2]} />
										</span>
										<span class="badge-copy">
											<strong>{item.label}</strong>
											<span>{item.detail}</span>
										</span>
									</Tag>
								</li>
							);
						})
					}
				</ul>
			</section>

			<section class="contact" aria-labelledby="contact-title" data-reveal>
				<h2 id="contact-title">Let's build <em>something</em></h2>
				<p>
					I'm driven by helping teams turn ideas into products. If you're looking for guidance on
					your next project, I'd love to hear from you.
				</p>
				<div class="contact-actions">
					<a class="btn btn--primary" href="mailto:allan@shinysoft.biz">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<rect
								x="3"
								y="5"
								width="18"
								height="14"
								rx="2"
								fill="none"
								stroke="currentColor"
								stroke-width="2"></rect>
							<path
								d="m3.5 7 8.5 6 8.5-6"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						<span>allan@shinysoft.biz</span>
					</a>
					<a
						class="btn btn--secondary"
						href="https://shinysoft.biz"
						target="_blank"
						rel="noopener noreferrer"><span>What ShinySoft can do</span></a
					>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			main {
				width: min(1120px, calc(100% - 2.5rem));
				max-width: none;
				margin: 0 auto;
				padding: 0;
				/* the full-bleed skyline is 100vw, which overshoots by the scrollbar width */
				overflow-x: clip;
			}

			/* ---------- hero ---------- */

			.hero {
				display: grid;
				gap: 2.5rem;
				align-items: center;
				padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 4vw, 3rem);
			}
			@media (min-width: 880px) {
				.hero {
					grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
					gap: 4rem;
				}
			}
			.facts {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 1.75rem 0 0;
				padding: 0;
			}
			.facts li {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				list-style: none;
				padding: 0.45rem 0.85rem 0.45rem 0.7rem;
				font-size: 0.85rem;
				color: rgb(var(--gray-dark));
				background: var(--glass);
				-webkit-backdrop-filter: blur(10px);
				backdrop-filter: blur(10px);
				border: 1px solid var(--border);
				border-radius: 999px;
			}
			.facts svg {
				flex: 0 0 auto;
				width: 1rem;
				height: 1rem;
				color: var(--accent);
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 2rem;
			}

			/* the portrait is a cut-out on white, so it sits in a light arch in both themes */
			.hero-portrait {
				position: relative;
				display: flex;
				align-items: flex-end;
				justify-content: center;
				aspect-ratio: 4 / 5;
				max-width: 420px;
				width: 100%;
				margin: 0 auto;
				background:
					radial-gradient(120% 80% at 50% 0%, rgba(124, 92, 255, 0.35), transparent 60%),
					linear-gradient(170deg, #efeaff, #faf8f4);
				border: 1px solid var(--border);
				border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
				box-shadow: var(--box-shadow);
				animation: enter 1.2s var(--ease-out) 0.2s both;
			}
			.hero-portrait > :global(img) {
				position: relative;
				width: 92%;
				height: auto;
				margin: 0;
				border-radius: 0;
				mix-blend-mode: multiply;
			}
			.portrait-glow {
				position: absolute;
				inset: 10% 0 -6%;
				z-index: -1;
				border-radius: 999px;
				background: var(--grad);
				filter: blur(70px);
				opacity: 0.4;
				animation: breathe 7s ease-in-out infinite;
			}
			@keyframes breathe {
				50% {
					opacity: 0.25;
					transform: scale(0.94);
				}
			}

			/* ---------- stats ---------- */

			.stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
				margin: 1rem 0 0;
			}

			/* ---------- sections ---------- */

			.story,
			.activity,
			.ventures,
			.recognition {
				margin-top: clamp(4rem, 8vw, 6.5rem);
			}
			.section-lede {
				max-width: 60ch;
				margin: 0 0 1.5rem;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}

			.story {
				display: grid;
				gap: 1.5rem 4rem;
			}
			@media (min-width: 880px) {
				.story {
					grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
				}
				.story-aside {
					position: sticky;
					top: calc(var(--header-h) + 2rem);
					align-self: start;
				}
			}
			.story-copy p {
				margin: 0 0 1.3rem;
				font-size: 1.08rem;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
				text-wrap: pretty;
			}
			.story-copy p:first-child::first-letter {
				float: left;
				margin: 0.08em 0.12em 0 0;
				font-family: var(--font-display);
				font-size: 4.2em;
				line-height: 0.8;
				color: var(--accent);
			}
			.story-copy p:last-child {
				margin-bottom: 0;
			}

			/* ---------- skyline band ---------- */

			.skyline {
				position: relative;
				width: min(1200px, calc(100vw - 2.5rem));
				margin: clamp(4rem, 8vw, 6.5rem) 0 0 50%;
				transform: translateX(-50%);
				overflow: hidden;
				border-radius: calc(var(--radius-lg) + 8px);
				box-shadow: var(--box-shadow);
			}
			.skyline.is-revealed,
			:global(.reveal-all) .skyline {
				translate: 0 0;
			}
			.skyline :global(img) {
				display: block;
				width: 100%;
				height: clamp(200px, 28vw, 360px);
				object-fit: cover;
				object-position: center 40%;
				margin: 0;
				border-radius: 0;
				transform: scale(1.08);
				transition: transform 2.4s var(--ease-out);
			}
			.skyline.is-revealed :global(img) {
				transform: none;
			}
			.skyline::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, transparent 35%, rgba(10, 8, 22, 0.7));
			}
			.skyline p {
				position: absolute;
				inset: auto 0 clamp(1.25rem, 3vw, 2.25rem);
				z-index: 1;
				margin: 0;
				text-align: center;
				font-family: var(--font-display);
				font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3.4rem);
				line-height: 1;
				color: #fff;
			}
			.skyline p span {
				display: block;
				margin-bottom: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				opacity: 0.8;
			}

			/* ---------- ventures ---------- */

			.venture-grid {
				display: grid;
				gap: 1.5rem;
				margin-top: 1.75rem;
			}
			@media (min-width: 820px) {
				.venture-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			.venture {
				display: flex;
				flex-direction: column;
				padding: 8px;
			}
			.venture-media {
				display: flex;
				align-items: center;
				justify-content: center;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: rgba(var(--gray-light), 45%);
				border-radius: calc(var(--radius-lg) - 8px);
			}
			.venture-media :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				margin: 0;
				border-radius: 0;
				transition: transform 0.9s var(--ease-out);
			}
			.venture:hover .venture-media :global(img) {
				transform: scale(1.05);
			}
			/* a wordmark shouldn't be cropped like a photo, and this one needs a
			   light plate to stay legible in dark mode */
			.venture-media--pad {
				background: linear-gradient(160deg, #ffffff, #f1eefa);
			}
			.venture-media--pad :global(img) {
				width: auto;
				max-width: 70%;
				height: auto;
				max-height: 58%;
				object-fit: contain;
			}
			.venture-copy {
				display: flex;
				flex: 1;
				flex-direction: column;
				gap: 0.55rem;
				padding: 1.25rem 1rem 1rem;
			}
			.flag {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.venture-copy h3 {
				margin: 0;
				font-family: var(--font-display);
				font-weight: 400;
				font-size: 2rem;
				letter-spacing: -0.01em;
			}
			.venture-copy p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.6;
				color: rgb(var(--gray));
				text-wrap: pretty;
			}
			.venture-links {
				position: relative;
				z-index: 1;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: auto;
				padding-top: 1rem;
			}

			/* ---------- recognition ---------- */

			.badge-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.25rem;
				margin: 1.75rem 0 0;
				padding: 0;
			}
			.badge-grid li {
				list-style: none;
				margin: 0;
			}
			.badge {
				display: flex;
				flex-direction: column;
				height: 100%;
				gap: 1rem;
				padding: 8px 8px 1.25rem;
				text-decoration: none;
				border-radius: var(--radius-lg);
			}
			.badge-frame {
				display: flex;
				align-items: center;
				justify-content: center;
				height: 120px;
				padding: 0.75rem;
				/* light plate so the badge art reads in both themes */
				background: linear-gradient(160deg, #ffffff, #f2effa);
				border-radius: calc(var(--radius-lg) - 8px);
			}
			.badge-frame :global(img) {
				width: auto;
				max-width: 100%;
				max-height: 90px;
				object-fit: contain;
				margin: 0;
				border-radius: 4px;
				transition: transform 0.6s var(--ease-spring);
			}
			a.badge:hover .badge-frame :global(img) {
				transform: scale(1.08) rotate(-2deg);
			}
			.badge-copy {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				padding: 0 0.6rem;
				line-height: 1.4;
			}
			.badge-copy strong {
				font-size: 1rem;
				color: rgb(var(--black));
			}
			.badge-copy span {
				font-size: 0.84rem;
